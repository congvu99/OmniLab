# Custom Caddyfile for Railpack static-file serving.
# Railpack auto-detects Astro (astro.config.mjs + output != "server") and
# would otherwise generate its own Caddyfile from
# https://github.com/railwayapp/railpack/blob/main/core/providers/staticfile/Caddyfile.template
# — this file overrides that default. Port + admin/https settings mirror the
# Railpack template so the platform's proxy/health-check assumptions still hold.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	root * dist

	# Compression before headers/file_server so encoded responses still get them.
	encode {
		gzip
		zstd
	}

	# --- Cache headers ---
	# Astro fingerprints /_astro/* assets by content hash, so they are safe to
	# cache forever. Everything else (clean-URL HTML, JSON indexes, manifest,
	# icons) must be revalidated (no-cache != no-store: the browser still caches
	# but checks freshness), otherwise a cached page can reference /_astro files
	# that a later deploy removed.
	@astroAssets path /_astro/*
	header @astroAssets Cache-Control "public, max-age=31536000, immutable"

	@notHashed not path /_astro/*
	header @notHashed Cache-Control "no-cache"

	# --- Security headers (all responses) ---
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# script-src 'self': astro.config.mjs sets vite.build.assetsInlineLimit: 0
		# so every component script ships as an external /_astro/*.js file (no
		# inline scripts, no hashes to keep in sync).
		# style-src allows 'unsafe-inline' only for style attributes emitted by
		# Shiki syntax highlighting in code blocks. Threat model: static content
		# site, no user-generated input, no auth/cookies, so inline-style
		# injection has no realistic attack path. Fonts are self-hosted.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
		-Server
	}

	# Hide dotfiles, serve everything else. No SPA fallback: unmatched clean
	# URLs (Astro emits /path/index.html) fall through to handle_errors below,
	# producing a real 404 instead of masking it with index.html.
	file_server {
		hide .git
		hide .env*
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
