# Custom Caddyfile for Railpack static-file serving.
# Railpack auto-detects Astro (astro.config.mjs + output != "server") and
# would otherwise generate its own Caddyfile from
# https://github.com/railwayapp/railpack/blob/main/core/providers/staticfile/Caddyfile.template
# — this file overrides that default. Port + admin/https settings mirror the
# Railpack template so the platform's proxy/health-check assumptions still hold.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	root * dist

	# Compression before headers/file_server so encoded responses still get them.
	encode {
		gzip
		zstd
	}

	# --- Progress sync API ---
	# /api/* goes to the sync sidecar (private network, alias omnilab-sync). Its
	# own responses (including its 503 "busy") pass through untouched, with
	# their own no-store. Where the sidecar does not exist (Railpack hosting,
	# sidecar stopped) the dial fails and handle_errors below answers 503 JSON,
	# so the static site keeps working and the client shows "unavailable".
	handle /api/* {
		reverse_proxy omnilab-sync:3000 {
			# Fail fast: a dead sidecar must not hold requests open.
			transport http {
				dial_timeout 2s
			}
		}
	}

	# --- Lesson audio ---
	# Written by the tts worker, mounted read-only into the app at /srv/audio
	# (compose). Only manifest.json and file names matching AUDIO_FILE_PATTERN
	# (src/lib/audio-manifest.ts) are served; everything else under /audio is a
	# bare 404 (handle_errors). Without the mount (Railpack, no tts) the manifest
	# is a 404 too, so the player stays hidden.
	# Nested handles: allowlisted names first, everything else 404, without
	# relying on how same-named directives get sorted. The path is not
	# stripped (root is the parent of audio/), so handle_errors still sees
	# /audio/* and answers the bare 404 below. AUDIO_ROOT only exists to try
	# this Caddyfile on a dev machine (a dir that contains audio/).
	handle /audio/* {
		@audioFile path_regexp ^/audio/(manifest\.json|[a-z0-9-]+\.[a-z0-9-]+\.[a-z0-9-]+\.[0-9a-f]{12}\.m4a)$
		handle @audioFile {
			root * {$AUDIO_ROOT:/srv}
			file_server
		}
		handle {
			error 404
		}
	}

	# --- Cache headers ---
	# Astro fingerprints /_astro/* assets by content hash, so they are safe to
	# cache forever. Everything else (clean-URL HTML, JSON indexes, manifest,
	# icons) must be revalidated (no-cache != no-store: the browser still caches
	# but checks freshness), otherwise a cached page can reference /_astro files
	# that a later deploy removed.
	@astroAssets path /_astro/*
	header @astroAssets Cache-Control "public, max-age=31536000, immutable"

	# Audio file names carry the audio key, so a name never changes content.
	# Content-Type is forced (not left to the OS MIME table): Safari needs
	# audio/mp4 to play. manifest.json stays no-cache via @notHashed.
	@audioMedia path_regexp ^/audio/.+\.m4a$
	header @audioMedia {
		Content-Type "audio/mp4"
		Cache-Control "public, max-age=31536000, immutable"
	}

	@notHashed {
		not path /_astro/* /api/*
		not path_regexp ^/audio/.+\.m4a$
	}
	header @notHashed Cache-Control "no-cache"

	# --- Security headers (all responses) ---
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No feature on this site needs any of these — deny all as defense in
		# depth (nothing regresses if a future page tries to use one; it just
		# gets a clear permission denial to fix instead of silent access).
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# script-src 'self': astro.config.mjs sets vite.build.assetsInlineLimit: 0
		# so every component script ships as an external /_astro/*.js file (no
		# inline scripts, no hashes to keep in sync).
		# style-src allows 'unsafe-inline' for every inline style attribute this
		# app renders: Shiki syntax highlighting in code blocks, the
		# domain-accent CSS custom properties set on <html> and on progress-ring/
		# search-result elements, and the handful of inline SVG illustrations
		# with their own <style> blocks. Threat model: the site now carries a
		# session cookie (HttpOnly, Path=/api) and shows the user's username, so
		# script injection must stay impossible: script-src stays 'self' (no
		# inline, no eval). 'unsafe-inline' for styles is kept because no HTML is
		# ever rendered from user input (the account island writes the username
		# with textContent), so inline-style injection has no attack path.
		# Fonts are self-hosted.
		# Lesson <audio> is same-origin (/audio/*), covered by default-src 'self'.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
		# reverse_proxy adds Via on /api responses; deferred here so it runs last.
		-Via
		-Server
	}

	# Hide dotfiles, serve everything else. No SPA fallback: unmatched clean
	# URLs (Astro emits /path/index.html) fall through to handle_errors below,
	# producing a real 404 instead of masking it with index.html.
	file_server {
		hide .git
		hide .env*
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		# Sidecar unreachable: JSON, never the HTML 404/502 page, never cached.
		@api path /api/*
		handle @api {
			header Cache-Control "no-store"
			header Content-Type "application/json"
			# \{ escapes the placeholder opener so the JSON survives the replacer.
			respond `\{"code":"unavailable"}` 503
		}

		# Audio: bare 404, never the HTML 404 page (root may point at the audio
		# mount here). Headers already set for .m4a (audio/mp4, immutable) are
		# overwritten so a 404 is neither typed as audio nor cached.
		@audio path /audio/*
		handle @audio {
			header Cache-Control "no-store"
			header Content-Type "text/plain; charset=utf-8"
			respond 404
		}

		handle {
			rewrite * /{err.status_code}.html
			file_server
		}
	}
}
