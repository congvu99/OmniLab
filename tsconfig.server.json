{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/lib/progress-state.ts", "src/lib/progress-merge.ts", "src/lib/progress-sync-types.ts", "src/lib/speech-script-contract.ts", "src/lib/audio-manifest.ts"]
}
