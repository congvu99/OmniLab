---
// Shell for the 4 top-level tab pages: sidebar (>=1024px) or bottom tab bar
// (<1024px) + optional iOS large-title header + <main>. Reader screens use
// reader-layout.astro instead (full-bleed, no tab chrome).
import { ClientRouter } from 'astro:transitions';
import BaseHead from './base-head.astro';
import { domainAccentStyle } from './domain-accent';
import TabBar from '../components/shell/tab-bar.astro';
import SidebarNav from '../components/shell/sidebar-nav.astro';
import LargeTitleHeader from '../components/shell/large-title-header.astro';

interface Props {
  title: string;
  description?: string;
  domainAccent?: string;
  domainAccentDark?: string;
  /** When set, renders the collapsing iOS large-title header above <slot/>. */
  largeTitle?: string;
}

const { title, description, domainAccent, domainAccentDark, largeTitle } = Astro.props;
const htmlStyle = domainAccentStyle(domainAccent, domainAccentDark);
---

<html lang="vi" style={htmlStyle}>
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Bỏ qua, đến nội dung chính</a>
    <SidebarNav />
    <div class="app-shell">
      {largeTitle && <LargeTitleHeader title={largeTitle} />}
      <main id="main-content" class="app-main">
        <slot />
      </main>
    </div>
    <TabBar />
    <script>
      // iOS Safari only arms the :active pseudo-class for tap feedback when a
      // touch listener exists somewhere on the page — this one is a no-op,
      // it just "wakes up" .tap-scale:active across the whole shell.
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
  </body>
</html>

<style>
  .app-shell {
    min-height: 100dvh;
  }

  .app-main {
    /* Room for the fixed bottom tab bar + its safe-area inset, plus a little
       breathing room so the last row of content isn't flush against it. */
    padding-bottom: calc(var(--shell-tabbar-h) + env(safe-area-inset-bottom) + var(--space-4));
  }

  @media (min-width: 1024px) {
    .app-shell {
      padding-left: var(--shell-sidebar-w);
    }

    .app-main {
      /* No bottom tab bar at this breakpoint (sidebar instead). */
      padding-bottom: var(--space-6);
    }
  }
</style>
