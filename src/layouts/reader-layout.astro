---
// Full-bleed reading shell: back button + collapsing title + progress bar
// (reader-top-bar.astro), no tab bar/sidebar (maximizes reading space per
// phase-02 spec). Default slot content is wrapped in <main id="reader-content"
// class="prose"> — consumers just drop MDX/HTML output in directly, no need
// to remember the "prose" class themselves.
import { ClientRouter } from 'astro:transitions';
import BaseHead from './base-head.astro';
import { domainAccentStyle } from './domain-accent';
import ReaderTopBar from '../components/shell/reader-top-bar.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  domainAccent?: string;
  domainAccentDark?: string;
  backHref: string;
  backLabel?: string;
}

const { title, description, domainAccent, domainAccentDark, backHref, backLabel } = Astro.props;
const htmlStyle = domainAccentStyle(domainAccent, domainAccentDark);
---

<html lang="vi" style={htmlStyle}>
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <a href="#reader-content" class="skip-link">Bỏ qua, đến nội dung chính</a>
    <ReaderTopBar title={title} backHref={backHref} backLabel={backLabel}>
      <slot name="top-actions" slot="top-actions" />
    </ReaderTopBar>
    <main id="reader-content" class="prose reader-content">
      <!-- Fallback page <h1>+<h2>: most lesson MDX bodies start with their
           own "# Title" (the real, visible <h1> reader-top-bar.astro watches
           via IntersectionObserver), but every finance lesson opens at "##"
           or "###" instead (fidelity-locked source text — cannot add a
           top-level heading there). Those pages had zero <h1> (axe
           page-has-heading-one). Always render a real <h1> here for the a11y
           tree; also render an <h2> filler so a body that opens at "###"
           doesn't jump 2 levels from our injected h1 (axe heading-order).
           The :has() rule below hides both — sighted AND assistive-tech,
           since display:none removes a11y-tree nodes too — whenever
           `.lesson-article` already supplies its own <h1>, so those lessons
           are untouched and no title is ever announced twice. -->
      <h1 class="reader-fallback-heading" data-reader-fallback-h1>{title}</h1>
      <h2 class="reader-fallback-heading" data-reader-fallback-h2>Nội dung bài</h2>
      <slot />
    </main>
    <script>
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
    <script>
      import { requestPersistentStorageIfStandalone } from '../lib/request-persistent-storage';

      // No iOS "Add to Home Screen" hint here (reader is full-bleed reading,
      // no room for a banner) — app-layout.astro's hint covers it on the 4
      // tab pages, which every reading session passes through anyway.
      document.addEventListener('astro:page-load', requestPersistentStorageIfStandalone);
    </script>
  </body>
</html>

<style>
  .reader-content {
    padding: var(--space-5) var(--space-4) var(--space-8);
  }

  /* sr-only: present for the accessibility tree/heading outline, invisible
     on screen. Hidden entirely (removed from the a11y tree too) when the
     lesson body already provides its own <h1> — see the comment above the
     elements in the markup. */
  .reader-fallback-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reader-content:has(.lesson-article h1) .reader-fallback-heading {
    display: none;
  }
</style>
