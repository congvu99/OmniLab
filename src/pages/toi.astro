---
// "Tôi" tab: personal settings and local data. Four groups; mobile shows
// them in source order (so keyboard/screen-reader order matches what is on
// screen), desktop puts them in two columns: account + progress | appearance + data.
//  1. Tài khoản & đồng bộ - account-sync-panel.astro (#tai-khoan).
//  2. Tiến độ học - headline numbers + per-domain progress (client-filled).
//  3. Giao diện - theme / reading size / motion (display-settings.astro).
//  4. Dữ liệu & ứng dụng - storage state, install tip, about, version.
import AppLayout from '../layouts/app-layout.astro';
import LargeTitleHeader from '../components/shell/large-title-header.astro';
import Icon from '../components/icon/icon.astro';
import DomainCard from '../components/domain/domain-card.astro';
import LearningStats from '../components/islands/learning-stats.astro';
import AccountSyncPanel from '../components/islands/account-sync-panel.astro';
import DisplaySettings from '../components/islands/display-settings.astro';
import StorageStatus from '../components/islands/storage-status.astro';
import { getDomains, getLessonsByDomain } from '../lib/content-queries';
import pkg from '../../package.json';

const domains = await getDomains();
const domainCards = await Promise.all(
  domains.map(async (domain) => {
    const lessons = await getLessonsByDomain(domain.id);
    return {
      domain,
      lessonCount: lessons.length,
      totalReadingMinutes: lessons.reduce((sum, l) => sum + l.readingMinutes, 0),
    };
  }),
);
const totalLessons = domainCards.reduce((sum, d) => sum + d.lessonCount, 0);
---

<AppLayout title="Tôi - OmniLab">
  <LargeTitleHeader title="Tôi" eyebrow="Giao diện · tiến độ · dữ liệu" />

  <div class="me">
    <div class="me__col">
      <section id="tai-khoan" class="me__sec me__sec--account" aria-labelledby="me-account">
        <AccountSyncPanel />
      </section>

      <section class="me__sec me__sec--progress" aria-labelledby="me-progress">
        <div class="sec-h">
          <h2 id="me-progress">Tiến độ học</h2>
          <a href="/">Học tiếp</a>
        </div>
        <LearningStats totalLessons={totalLessons} />
        <ul class="rows me__rows">
          {
            domainCards.map(({ domain, lessonCount, totalReadingMinutes }, i) => (
              <li>
                <DomainCard
                  variant="row"
                  href={`/linh-vuc/${domain.id}`}
                  domainId={domain.id}
                  icon={domain.data.icon}
                  title={domain.data.title}
                  tagline={domain.data.tagline}
                  accent={domain.data.accent}
                  accentDark={domain.data.accentDark}
                  lessonCount={lessonCount}
                  totalReadingMinutes={totalReadingMinutes}
                  stagger={i}
                />
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <div class="me__col">
      <section class="me__sec me__sec--ui" aria-labelledby="me-ui">
        <div class="sec-h"><h2 id="me-ui">Giao diện</h2></div>
        <DisplaySettings />
      </section>

      <section class="me__sec me__sec--data" aria-labelledby="me-data">
        <div class="sec-h"><h2 id="me-data">Dữ liệu &amp; ứng dụng</h2></div>
        <StorageStatus />
        <ul class="rows me__rows">
          <li>
            <a href="/gioi-thieu" class="row">
              <span class="dom-ic"><Icon name="doc" size={21} /></span>
              <span class="tt">
                <b>Giới thiệu &amp; bản quyền</b>
                <small>Nguồn nội dung · giấy phép · miễn trừ</small>
              </span>
              <Icon name="chevron-right" size={18} class="chev" />
            </a>
          </li>
        </ul>
        <p class="me__note">
          Nội dung chỉ nhằm mục đích học tập, không phải tư vấn tài chính hay đầu tư.
        </p>
        <p class="me__version tnum">OmniLab v{pkg.version}</p>
      </section>
    </div>
  </div>
</AppLayout>

<style>
  .me {
    display: grid;
    gap: 0 var(--space-6);
    padding-inline: var(--gutter-l) var(--gutter-r);
    padding-bottom: var(--space-5);
  }

  /* Mobile: one column in source order (no CSS reordering, so focus order
     follows the visual order). */
  .me__col {
    display: contents;
  }

  /* The slot takes no space until something is mounted into it. */
  .me__sec--account:empty {
    display: none;
  }

  .me__sec {
    min-width: 0;
  }

  .me__rows {
    margin: var(--space-3) -8px 0;
  }

  .me__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--text-2);
  }

  .me__version {
    margin: var(--space-2) 0 0;
    font: 400 var(--text-label) / 1.5 var(--font-mono);
    color: var(--text-3);
  }

  @media (min-width: 1024px) {
    .me {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .me__col {
      display: block;
      min-width: 0;
    }
  }
</style>
