---
// "Đã lưu" tab — empty state (Phase 5 adds bookmark persistence via
// localStorage + reads it here).
import AppLayout from '../layouts/app-layout.astro';
import Bookmark from '@lucide/astro/icons/bookmark';
---

<AppLayout title="Đã lưu - OmniLab" largeTitle="Đã lưu">
  <div class="empty-state">
    <Bookmark size={40} stroke-width={1.75} aria-hidden="true" />
    <p class="empty-title">Chưa có bài đã lưu</p>
    <p class="empty-body">Đánh dấu bài học khi đọc để xem lại ở đây.</p>
  </div>
</AppLayout>

<style>
  .empty-state {
    margin: var(--space-6) var(--space-4);
    padding: var(--space-6) var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    color: var(--ink-2);
  }

  .empty-title {
    font-size: var(--text-title3);
    font-weight: 700;
    color: var(--ink);
  }

  .empty-body {
    max-width: 32ch;
  }
</style>
