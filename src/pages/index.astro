---
// "Học tiếp" tab — continue-reading-card.astro fills `.continue-reading-slot`
// client-side from localStorage (empty on a first visit, before any lesson
// has been read), so below it we always show every domain with a
// "Bắt đầu từ bài 1" CTA straight into its first lesson.
import AppLayout from '../layouts/app-layout.astro';
import DomainCard from '../components/domain/domain-card.astro';
import ContinueReadingCard from '../components/islands/continue-reading-card.astro';
import { getDomains, getLessonsByDomain } from '../lib/content-queries';

const domains = await getDomains();
const domainCards = await Promise.all(
  domains.map(async (domain) => {
    const lessons = await getLessonsByDomain(domain.id);
    const totalReadingMinutes = lessons.reduce((sum, l) => sum + l.readingMinutes, 0);
    return {
      domain,
      lessonCount: lessons.length,
      totalReadingMinutes,
      firstLessonUrl: lessons[0]?.url ?? `/linh-vuc/${domain.id}`,
    };
  }),
);
---

<AppLayout title="OmniLab" largeTitle="Học tiếp">
  <ContinueReadingCard />
  <ul class="domain-list">
    {
      domainCards.map(({ domain, lessonCount, totalReadingMinutes, firstLessonUrl }) => (
        <li>
          <DomainCard
            href={firstLessonUrl}
            domainId={domain.id}
            icon={domain.data.icon}
            title={domain.data.title}
            tagline={domain.data.tagline}
            accent={domain.data.accent}
            accentDark={domain.data.accentDark}
            lessonCount={lessonCount}
            totalReadingMinutes={totalReadingMinutes}
            ctaLabel="Bắt đầu từ bài 1"
          />
        </li>
      ))
    }
  </ul>
</AppLayout>

<style>
  .domain-list {
    margin: var(--space-4);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .domain-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
