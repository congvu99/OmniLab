---
// "Lĩnh vực" tab — real domain cards from the content collection (accent,
// icon, tagline, lesson count, reading minutes, live progress-ring), each
// linking to its /linh-vuc/<domain> detail page.
import AppLayout from '../../layouts/app-layout.astro';
import DomainCard from '../../components/domain/domain-card.astro';
import { getDomains, getLessonsByDomain } from '../../lib/content-queries';

const domains = await getDomains();
const domainCards = await Promise.all(
  domains.map(async (domain) => {
    const lessons = await getLessonsByDomain(domain.id);
    const totalReadingMinutes = lessons.reduce((sum, l) => sum + l.readingMinutes, 0);
    return { domain, lessonCount: lessons.length, totalReadingMinutes };
  }),
);
---

<AppLayout title="Lĩnh vực - OmniLab" largeTitle="Lĩnh vực">
  <ul class="domain-list">
    {
      domainCards.map(({ domain, lessonCount, totalReadingMinutes }) => (
        <li>
          <DomainCard
            href={`/linh-vuc/${domain.id}`}
            domainId={domain.id}
            icon={domain.data.icon}
            title={domain.data.title}
            tagline={domain.data.tagline}
            accent={domain.data.accent}
            accentDark={domain.data.accentDark}
            lessonCount={lessonCount}
            totalReadingMinutes={totalReadingMinutes}
          />
        </li>
      ))
    }
  </ul>
  <p class="linh-vuc-footer">
    <a href="/gioi-thieu">Nguồn & giấy phép nội dung</a>
  </p>
</AppLayout>

<style>
  .domain-list {
    margin: var(--space-4);
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .domain-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .linh-vuc-footer {
    margin: var(--space-5) var(--space-4);
    text-align: center;
    font-size: var(--text-caption);
  }

  .linh-vuc-footer a {
    color: var(--ink-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
