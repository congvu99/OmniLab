---
// "Lĩnh vực" tab — one art card per domain from the content collection
// (index, tagline, lesson count, reading minutes, live progress bar), each
// linking to its /linh-vuc/<domain> page.
import AppLayout from '../../layouts/app-layout.astro';
import LargeTitleHeader from '../../components/shell/large-title-header.astro';
import DomainCard from '../../components/domain/domain-card.astro';
import { getDomains, getLessonsByDomain } from '../../lib/content-queries';

const domains = await getDomains();
const domainCards = await Promise.all(
  domains.map(async (domain) => {
    const lessons = await getLessonsByDomain(domain.id);
    const totalReadingMinutes = lessons.reduce((sum, l) => sum + l.readingMinutes, 0);
    return { domain, lessonCount: lessons.length, totalReadingMinutes };
  }),
);
const totalLessons = domainCards.reduce((sum, d) => sum + d.lessonCount, 0);
---

<AppLayout title="Lĩnh vực - OmniLab">
  <LargeTitleHeader title="Lĩnh vực" eyebrow={`${domains.length} lĩnh vực · ${totalLessons} bài`} />
  <ul class="domain-grid">
    {
      domainCards.map(({ domain, lessonCount, totalReadingMinutes }, i) => (
        <li>
          <DomainCard
            href={`/linh-vuc/${domain.id}`}
            domainId={domain.id}
            icon={domain.data.icon}
            title={domain.data.title}
            tagline={domain.data.tagline}
            accent={domain.data.accent}
            accentDark={domain.data.accentDark}
            lessonCount={lessonCount}
            totalReadingMinutes={totalReadingMinutes}
            index={i + 1}
            headingLevel={2}
            stagger={i}
          />
        </li>
      ))
    }
  </ul>
  <p class="linh-vuc-footer">
    <a href="/gioi-thieu">Nguồn &amp; giấy phép nội dung</a>
  </p>
</AppLayout>

<style>
  /* Concept: 16px side margins on phones, then a fluid multi-column grid. */
  .domain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
    margin: 0;
    padding-inline: calc(var(--gutter-l) - 4px) calc(var(--gutter-r) - 4px);
  }

  .linh-vuc-footer {
    margin: var(--space-5) 0 0;
    padding-inline: var(--gutter-l) var(--gutter-r);
    text-align: center;
  }

  .linh-vuc-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 var(--text-label) var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--volt-ink);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .domain-grid {
      gap: 16px;
      padding-inline: var(--gutter-l) var(--gutter-r);
    }
  }
</style>
