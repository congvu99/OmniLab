---
// Domain summary, two variants (concept "Studio"):
//  - "card": art header + mono index, 20px/800 title, tagline, footer with
//    counts and a live progress bar (Lĩnh vực tab, desktop Học tiếp grid).
//  - "row": 40px tinted icon tile, title, mono meta and a mini % + bar (mobile
//    Học tiếp list); the parent supplies the `.rows > li` wrapper.
// The whole item is one link (>=44px tall). The domain hue comes from the
// content YAML via .hue (--hue-l / --hue-d), so a new domain needs no code.
//
// Icon: domain YAML authors an icon name (e.g. "network"); <Icon> maps it to
// the sprite set and falls back to a generic glyph for unknown names.
import IconGlyph from '../icon/icon.astro';
import DomainArt from './domain-art.astro';
import DomainProgress from '../islands/domain-progress.astro';

interface Props {
  href: string;
  domainId: string;
  icon: string;
  title: string;
  tagline: string;
  accent: string;
  accentDark: string;
  lessonCount: number;
  totalReadingMinutes: number;
  variant?: 'card' | 'row';
  /** 1-based position, shown as "01" on the card variant. */
  index?: number;
  /** Heading level of the card title (2 on pages where cards sit directly under the h1). */
  headingLevel?: 2 | 3;
  /** Stagger slot (--i) for the entrance animation. */
  stagger?: number;
}

const {
  href,
  domainId,
  icon,
  title,
  tagline,
  accent,
  accentDark,
  lessonCount,
  totalReadingMinutes,
  variant = 'card',
  index,
  headingLevel = 3,
  stagger = 0,
} = Astro.props;
const isRow = variant === 'row';
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const hue = `--hue-l:${accent};--hue-d:${accentDark};--i:${stagger}`;
---

{
  isRow ? (
    <a href={href} class="row drow hue rise" style={hue}>
      <span class="dom-ic">
        <IconGlyph name={icon} size={21} />
      </span>
      <span class="tt">
        <b>{title}</b>
        <small class="tnum">
          {lessonCount} bài · {totalReadingMinutes} phút
        </small>
      </span>
      <DomainProgress domainId={domainId} layout="stack" />
    </a>
  ) : (
    <a href={href} class="dcard hue rise" style={hue}>
      <span class="dcard__art">
        <DomainArt domainId={domainId} />
        {index !== undefined && <span class="dcard__num tnum">{String(index).padStart(2, '0')}</span>}
      </span>
      <Heading class="dcard__title">{title}</Heading>
      <p class="dcard__tagline">{tagline}</p>
      <span class="dcard__ft tnum">
        <span>{lessonCount} bài</span>
        <span>{totalReadingMinutes} phút</span>
        <DomainProgress domainId={domainId} layout="inline" />
      </span>
    </a>
  )
}

<style>
  /* ---- row ---- */
  .drow {
    color: var(--text);
  }

  /* ---- card ---- */
  .dcard {
    position: relative;
    display: block;
    height: 100%;
    padding: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--glow);
    color: var(--text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--dur-1) var(--ease),
      border-color var(--dur-1);
  }

  .dcard:active {
    transform: scale(0.985);
  }

  @media (hover: hover) {
    .dcard:hover {
      border-color: color-mix(in srgb, var(--c) 40%, var(--line));
    }
  }

  .dcard__art {
    position: relative;
    display: block;
    height: 92px;
    margin: -16px -16px 14px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  @supports (color: color-mix(in srgb, red 10%, blue)) {
    .dcard__art {
      background: linear-gradient(180deg, color-mix(in srgb, var(--c) 14%, var(--surface)), var(--surface));
    }
  }

  .dcard__num {
    position: absolute;
    top: 12px;
    right: 14px;
    font: 500 11px var(--font-mono);
    color: var(--text-3);
  }

  .dcard__title {
    font-size: var(--text-title3);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: var(--track-heading);
  }

  .dcard__tagline {
    margin: 6px 0 14px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-2);
  }

  .dcard__ft {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 11.5px var(--font-mono);
    color: var(--text-3);
  }

  @media (min-width: 1024px) {
    .dcard__art {
      height: 110px;
    }
  }
</style>
