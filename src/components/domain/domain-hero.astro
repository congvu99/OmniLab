---
// Header of /linh-vuc/[domain]. Mobile (concept "dhero"): tinted icon tile,
// 32px/800 title, tagline, mono KPI line and one full-width volt CTA.
// Desktop: a card with the domain's line-art band on top, title block on the
// left, live progress ring + CTA on the right.
//
// This component owns the page <h1> and the collapse sentinel the pinned nav
// bar (large-title-header.astro, `bare`) observes. The CTA is server-rendered
// to the first lesson; domain-page-controls.astro retargets it to the first
// unfinished lesson from localStorage.
import Icon from '../icon/icon.astro';
import DomainArt from './domain-art.astro';
import ProgressRing from '../islands/progress-ring.astro';

interface Props {
  domainId: string;
  title: string;
  icon: string;
  tagline: string;
  accent: string;
  accentDark: string;
  lessonCount: number;
  totalReadingMinutes: number;
  moduleCount: number;
  firstLessonUrl: string;
}

const {
  domainId,
  title,
  icon,
  tagline,
  accent,
  accentDark,
  lessonCount,
  totalReadingMinutes,
  moduleCount,
  firstLessonUrl,
} = Astro.props;
---

<section class="dhero hue" style={`--hue-l:${accent};--hue-d:${accentDark}`} data-domain-hero>
  <div class="dhero__card">
  <div class="dhero__art" aria-hidden="true"><DomainArt domainId={domainId} fit="meet" /></div>
  <div class="dhero__body">
    <div class="dhero__main">
      <span class="dom-ic dhero__ic rise" style="--i:0"><Icon name={icon} size={28} /></span>
      <h1 class="dhero__title rise" style="--i:1">{title}</h1>
      <span class="dhero__sentinel" data-lth-sentinel aria-hidden="true"></span>
      <p class="dhero__tagline rise" style="--i:2">{tagline}</p>
      <ul class="dhero__kpis tnum rise" style="--i:3">
        <li><b>{lessonCount}</b> bài</li>
        <li><b>{totalReadingMinutes}</b> phút</li>
        <li><b>{moduleCount}</b> module</li>
        <li><b data-dh-percent>0%</b> xong</li>
      </ul>
    </div>
    <div class="dhero__side rise" style="--i:4">
      <div class="dhero__ring"><ProgressRing domainId={domainId} size={64} showFraction /></div>
      <a href={firstLessonUrl} class="btn btn-primary dhero__cta" data-domain-cta>
        <span data-cta-label>Bắt đầu: bài 01</span>
        <Icon name="arrow-right" size={18} stroke-width={1.75} />
      </a>
    </div>
  </div>
  </div>
</section>

<style>
  .dhero {
    padding: 8px var(--gutter-r) 20px var(--gutter-l);
  }

  .dhero__art {
    display: none;
  }

  .dhero__ic {
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    border-radius: var(--radius-lg);
    font-size: 28px;
  }

  .dhero__title {
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }

  .dhero__sentinel {
    display: block;
    height: 1px;
  }

  .dhero__tagline {
    margin: 8px 0 16px;
    font-size: var(--text-subhead);
    line-height: var(--leading-normal);
    color: var(--text-2);
  }

  .dhero__kpis {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-bottom: 16px;
    font: 500 12px var(--font-mono);
    color: var(--text-3);
  }

  .dhero__kpis b {
    font-weight: 500;
    color: var(--text);
  }

  .dhero__ring {
    display: none;
  }

  .dhero__cta {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .dhero {
      max-width: calc(var(--shell-content-max) + var(--gutter-l) + var(--gutter-r));
      margin: 40px auto 0;
      padding: 0 var(--gutter-r) 0 var(--gutter-l);
    }

    .dhero__card {
      overflow: hidden;
      border: 1px solid var(--line-2);
      border-radius: var(--radius-card);
      background: var(--surface);
      box-shadow: var(--glow), var(--shadow);
    }

    .dhero__art {
      position: relative;
      display: block;
      height: 128px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(180deg, var(--surface-2), var(--surface));
    }

    .dhero__body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 32px;
      padding: 0 32px 32px;
    }

    .dhero__ic {
      margin-top: -28px;
      border-radius: 16px;
      background: var(--surface);
      box-shadow: inset 0 0 0 1px var(--line-2), var(--shadow);
      position: relative;
    }

    .dhero__title {
      font-size: var(--text-display-d);
      line-height: 1;
      letter-spacing: -0.05em;
    }

    .dhero__tagline {
      max-width: 56ch;
      margin: 12px 0 16px;
      font-size: var(--text-callout);
    }

    .dhero__kpis {
      margin-bottom: 0;
    }

    .dhero__side {
      display: grid;
      justify-items: end;
      gap: 20px;
    }

    .dhero__ring {
      display: block;
    }

    .dhero__cta {
      width: auto;
    }
  }

  @supports (color: color-mix(in srgb, red 10%, blue)) {
    @media (min-width: 1024px) {
      .dhero__art {
        background: linear-gradient(180deg, color-mix(in srgb, var(--c) 14%, var(--surface)), var(--surface));
      }
    }
  }
</style>
