---
// One lesson row inside a module list on /linh-vuc/[domain] (concept
// ".row" + mono index + status dot). The row root (this <a>) carries
// data-lesson-id/data-domain/data-done — the DOM contract the progress script
// below (and any progress-store subscriber) reads. Visual state, set
// client-side on both the row and its `.st` dot:
//   data-done="true"      -> volt disc with a check
//   data-state="reading"  -> started, not done: ring filled to the scroll ratio
//   (neither)             -> empty ring
// The visually-hidden status text keeps the state non-color-only.
import Icon from '../icon/icon.astro';

interface Props {
  href: string;
  /** 1-based position within the whole domain, shown as "04". */
  index: number;
  title: string;
  readingMinutes: number;
  lessonId: string;
  domainId: string;
  /** Stagger slot (--i) for the entrance animation. */
  stagger?: number;
}

const { href, index, title, readingMinutes, lessonId, domainId, stagger = 0 } = Astro.props;
---

<a
  href={href}
  class="row lesson-row rise"
  style={`--i:${stagger}`}
  data-lesson-id={lessonId}
  data-domain={domainId}
  data-done="false"
>
  <span class="idx tnum">{String(index).padStart(2, '0')}</span>
  <span class="tt">
    <b>{title}</b>
    <small class="tnum">
      {readingMinutes} phút đọc
      <span class="sr-only" data-lesson-status-text></span>
    </small>
  </span>
  <span class="st lesson-status" aria-hidden="true">
    <Icon name="check" size={13} stroke-width={2.4} />
  </span>
</a>

<style>
  /* Long Vietnamese titles lose their meaning when cut: allow two lines. */
  .lesson-row :global(.tt b) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  /* The check only shows on a done disc. */
  .lesson-status :global(.ic) {
    display: none;
  }

  .lesson-status.done :global(.ic) {
    display: block;
  }

  /* In progress: arc = scroll ratio over a full hairline ring (base .st.prog
     leaves the rest transparent). */
  .lesson-status.prog {
    background: conic-gradient(var(--volt-ink) calc(var(--p, 0) * 1%), var(--line-3) 0);
  }
</style>

<script>
  // Decorates every `.lesson-row` with done / in-progress state. Astro dedupes
  // identical component <script> content, so this runs once per page
  // regardless of how many lesson-row instances render it.
  import { getProgressStore } from '../../lib/progress-store';

  let unsubscribe: (() => void) | null = null;

  function init() {
    unsubscribe?.();
    unsubscribe = null;

    const rows = Array.from(document.querySelectorAll<HTMLElement>('.lesson-row[data-lesson-id]'));
    if (rows.length === 0) return;

    const store = getProgressStore();
    unsubscribe = store.subscribe((state) => {
      for (const row of rows) {
        const lessonId = row.dataset.lessonId;
        if (!lessonId) continue;
        const entry = state.lessons[lessonId];
        const done = Boolean(entry?.done);
        const reading = !done && entry?.visitedAt !== undefined;
        row.dataset.done = String(done);
        if (reading) row.dataset.state = 'reading';
        else delete row.dataset.state;

        const dot = row.querySelector<HTMLElement>('.lesson-status');
        if (dot) {
          dot.classList.toggle('done', done);
          dot.classList.toggle('prog', reading);
          // At least a sliver, so "started" is visible even at 0% scroll.
          dot.style.setProperty('--p', String(Math.max(8, Math.round((entry?.scroll ?? 0) * 100))));
        }
        const text = row.querySelector<HTMLElement>('[data-lesson-status-text]');
        if (text) text.textContent = done ? ' · Đã hoàn thành' : reading ? ' · Đang đọc' : '';
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
