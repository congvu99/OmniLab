---
// One lesson row inside a module section on /linh-vuc/[domain]. The row root
// (this <a>) carries data-lesson-id/data-domain — the DOM contract Phase 5's
// progress-tracking island reads to know which row it's decorating (see
// phase-04 report, "DOM contracts for Phase 5"). `.lesson-status-slot` is the
// empty element Phase 5 fills with a checkmark once a lesson is marked done.
import CircleCheck from '@lucide/astro/icons/circle-check';

interface Props {
  href: string;
  order: number;
  title: string;
  readingMinutes: number;
  lessonId: string;
  domainId: string;
}

const { href, order, title, readingMinutes, lessonId, domainId } = Astro.props;
---

<a href={href} class="lesson-row tap-scale" data-lesson-id={lessonId} data-domain={domainId} data-done="false">
  <span class="lesson-row__order" aria-hidden="true">{order}</span>
  <span class="lesson-row__body">
    <span class="lesson-row__title">{title}</span>
    <span class="lesson-row__meta">{readingMinutes} phút đọc</span>
  </span>
  <span class="lesson-status-slot">
    <CircleCheck size={20} stroke-width={2} aria-hidden="true" class="lesson-status-icon" />
    <span class="lesson-status-text visually-hidden" data-lesson-status-text></span>
  </span>
</a>

<style>
  .lesson-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
  }

  li:last-child > .lesson-row {
    border-bottom: none;
  }

  .lesson-row__order {
    flex-shrink: 0;
    width: 24px;
    text-align: center;
    font-size: var(--text-footnote);
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .lesson-row__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lesson-row__title {
    font-size: var(--text-body);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lesson-row__meta {
    font-size: var(--text-caption);
    color: var(--ink-2);
  }

  /* Checkmark hidden until the row's own [data-done] (toggled client-side —
     see the <script> below) flips to "true"; the visually-hidden text next
     to it is the non-color-only signal for screen readers. */
  .lesson-status-slot {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: var(--success);
  }

  .lesson-status-icon {
    display: none;
  }

  .lesson-row[data-done='true'] .lesson-status-icon {
    display: block;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Decorates every `.lesson-row` on the page with a checkmark once its
  // lesson is done. Astro dedupes identical component <script> content, so
  // this runs once per page regardless of how many lesson-row instances
  // render it (same reasoning as domain-card.astro's bootstrap script).
  import { getProgressStore } from '../../lib/progress-store';

  let unsubscribe: (() => void) | null = null;

  function init() {
    unsubscribe?.();
    unsubscribe = null;

    const rows = Array.from(document.querySelectorAll<HTMLElement>('.lesson-row[data-lesson-id]'));
    if (rows.length === 0) return;

    const store = getProgressStore();
    unsubscribe = store.subscribe((state) => {
      for (const row of rows) {
        const lessonId = row.dataset.lessonId;
        if (!lessonId) continue;
        const done = Boolean(state.lessons[lessonId]?.done);
        row.dataset.done = String(done);
        const text = row.querySelector<HTMLElement>('[data-lesson-status-text]');
        if (text) text.textContent = done ? 'Đã hoàn thành' : '';
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
