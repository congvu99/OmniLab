---
// iOS-style large title (34px) that collapses into a small 17px title inside
// a sticky nav bar once scrolled past, via IntersectionObserver (no scroll
// listener). Used by app-layout.astro for the 4 top-level tab pages.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- The sticky bar is a SIBLING of <header>, not a child: a sticky element
     only sticks within its parent's box, so inside the (short) <header> it
     scrolled away with the large title. As a direct child of .app-shell it
     stays pinned for the whole page. Its small title duplicates the <h1>, so
     it is aria-hidden (also keeps it out of axe's "region" landmark rule). -->
<div class="lth-navbar" data-lth-navbar data-collapsed="false">
  <div class="lth-navbar-inner">
    <span class="lth-navbar-title" data-lth-navbar-title aria-hidden="true">{title}</span>
  </div>
</div>
<header class="lth-wrapper">
  <div class="lth-block">
    <h1 class="lth-title">{title}</h1>
    <span class="lth-sentinel" data-lth-sentinel aria-hidden="true"></span>
  </div>
</header>

<style>
  .lth-navbar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top);
    /* Expanded (top of page): invisible, blends into --bg so it reads as the
       space above the large title rather than an empty white band.
       Collapsed: solid surface + hairline (a translucent veil let the list
       text ghost through behind the small title). */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .lth-navbar[data-collapsed='true'] {
    background: var(--surface);
    border-bottom-color: var(--line);
  }

  .lth-navbar-inner {
    height: var(--shell-navbar-h);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--gutter-l) var(--gutter-r);
  }

  .lth-navbar-title {
    font-size: var(--text-body);
    font-weight: 600;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    text-align: center;
  }

  .lth-navbar[data-collapsed='true'] .lth-navbar-title {
    opacity: 1;
  }

  .lth-block {
    padding: 0 var(--gutter-r) var(--space-3) var(--gutter-l);
  }

  .lth-title {
    font-size: var(--text-large);
    font-weight: 700;
    line-height: 1.15;
    padding-top: var(--space-1);
  }

  .lth-sentinel {
    display: block;
    height: 1px;
  }
</style>

<script>
  // One large-title-header instance per page (iOS large-title pattern is a
  // single per-screen header) — plain querySelector is enough, no scoping.
  // Re-bound on every soft navigation (onPageLoad): navbar/sentinel are
  // fresh DOM nodes after each swap, and the previous page's observer must
  // be disconnected before its nodes are discarded (see page-lifecycle.ts).
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const navbar = document.querySelector<HTMLElement>('[data-lth-navbar]');
    const sentinel = document.querySelector<HTMLElement>('[data-lth-sentinel]');

    if (!navbar || !sentinel || !('IntersectionObserver' in window)) return;

    // Read the token rather than duplicating it here (44 = fallback only).
    const navbarHeight =
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--shell-navbar-h')) || 44;
    const observer = new IntersectionObserver(
      ([entry]) => {
        navbar.dataset.collapsed = entry.isIntersecting ? 'false' : 'true';
      },
      { rootMargin: `-${navbarHeight}px 0px 0px 0px`, threshold: 0 },
    );
    observer.observe(sentinel);

    return () => observer.disconnect();
  });
</script>
