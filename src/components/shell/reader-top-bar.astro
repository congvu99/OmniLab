---
// Reader-mode top bar (the dock below auto-hides while reading): back button
// (>=44pt target, volt-ink), title that fades in once
// the article's own <h1> (rendered inside reader-layout's #reader-content)
// scrolls behind the bar, a slot for actions (bookmark-button.astro), and a
// reading-progress bar driven by `transform: scaleX()` (not `width` — avoids
// layout/paint, GPU-composited).
import Icon from '../icon/icon.astro';

interface Props {
  title: string;
  backHref: string;
  backLabel?: string;
}

const { title, backHref, backLabel = 'Quay lại' } = Astro.props;
// `backLabel` is usually the target's own name (e.g. the domain title,
// "Kiến trúc hệ thống") for the VISIBLE label — but used alone as the
// accessible name, a screen reader announces just that name with no
// indication this link goes BACK, not forward into it. Always prefix the
// accessible name with "Quay lại" (skipped only when backLabel already IS
// "Quay lại", the no-target-name fallback, to avoid announcing it twice).
const backAriaLabel = backLabel === 'Quay lại' ? backLabel : `Quay lại ${backLabel}`;
---

<header class="rtb-bar" data-rtb-bar>
  <div class="rtb-row">
    <a href={backHref} class="rtb-back tap-scale" aria-label={backAriaLabel}>
      <Icon name="chevron-left" size={22} stroke-width={1.75} />
      <span class="rtb-back-label">{backLabel}</span>
    </a>
    <span class="rtb-title" data-rtb-title>{title}</span>
    <div class="rtb-actions">
      <slot name="top-actions" />
    </div>
  </div>
  <div class="rtb-progress-track" aria-hidden="true">
    <div class="rtb-progress-bar" data-rtb-progress></div>
  </div>
</header>

<style>
.rtb-bar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top);
    /* Concept navbar: transparent over the article header, material + hairline
       once the page has scrolled. */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  .rtb-bar[data-solid='true'] {
    background: var(--material-bar);
    -webkit-backdrop-filter: var(--material-blur);
    backdrop-filter: var(--material-blur);
    border-bottom-color: var(--line);
  }

  .rtb-row {
    height: var(--shell-navbar-h);
    display: grid;
    grid-template-columns: minmax(44px, auto) minmax(0, 1fr) minmax(44px, auto);
    align-items: center;
    gap: var(--space-2);
    padding-inline: max(var(--space-2), env(safe-area-inset-left)) max(var(--space-2), env(safe-area-inset-right));
  }

  .rtb-back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 44px;
    min-width: 44px;
    padding-inline: var(--space-1) var(--space-2);
    border-radius: 10px;
    color: var(--volt-ink);
    transition: opacity var(--dur-1) var(--ease);
    text-decoration: none;
    font-size: var(--text-subhead);
    font-weight: 600;
  }

  .rtb-back-label {
    max-width: 42vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rtb-title {
    justify-self: center;
    text-align: center;
    font-size: 14.5px;
    font-weight: 700;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--dur-2),
      transform var(--dur-2) var(--ease);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .rtb-bar[data-collapsed='true'] .rtb-title {
    opacity: 1;
    transform: none;
  }

  .rtb-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 44px;
  }

  /* 2px volt-ink reading progress hugging the bar's bottom hairline (concept
     .rprog), with the volt glow. */
  .rtb-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
  }

  .rtb-progress-bar {
    height: 100%;
    width: 100%;
    background: var(--volt-ink);
    box-shadow: 0 0 8px var(--volt);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='reduce'])) .rtb-progress-bar {
      transition: transform var(--dur-1) linear;
    }
  }

  /* Desktop: the sidebar owns the left edge; shift the bar so the back
     button and title are centered over the content area, not the viewport. */
  @media (min-width: 1024px) {
    .rtb-bar {
      margin-left: var(--shell-sidebar-w);
    }
  }
</style>

<script>
  // Re-bound on every soft navigation (onPageLoad): the bar, progress track
  // and article heading are fresh DOM nodes after each swap, and the
  // IntersectionObserver/scroll listener from the previous page must be
  // disconnected before that page's nodes are discarded (see page-lifecycle.ts).
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const bar = document.querySelector<HTMLElement>('[data-rtb-bar]');
    const progress = document.querySelector<HTMLElement>('[data-rtb-progress]');
    // reader-layout.astro wraps the slotted lesson body in <main id="reader-content">;
    // its first <h1> is the article's own "large title" that this bar's small
    // title stands in for once scrolled away.
    // The layout's sr-only fallback <h1> is display:none (never intersects)
    // whenever the lesson renders its own visible <h1>, so skip it.
    const articleHeading = document.querySelector<HTMLElement>(
      '#reader-content h1:not([data-reader-fallback-h1])',
    );

    let observer: IntersectionObserver | undefined;
    let onScroll: (() => void) | undefined;

    if (bar && articleHeading && 'IntersectionObserver' in window) {
      // Read the token rather than duplicating it here (44 = fallback only).
      const navbarHeight =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--shell-navbar-h')) || 44;
      observer = new IntersectionObserver(
        ([entry]) => {
          bar.dataset.collapsed = entry.isIntersecting ? 'false' : 'true';
        },
        { rootMargin: `-${navbarHeight}px 0px 0px 0px`, threshold: 0 },
      );
      observer.observe(articleHeading);
    } else if (bar) {
      // No article heading found (shouldn't happen for real lesson content) —
      // show the title immediately rather than leaving it permanently blank.
      bar.dataset.collapsed = 'true';
    }

    if (progress) {
      let ticking = false;
      const updateProgress = () => {
        ticking = false;
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - doc.clientHeight;
        const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        progress.style.transform = `scaleX(${ratio})`;
      };
      const syncSolid = () => {
        if (bar) bar.dataset.solid = String(window.scrollY > 24);
      };
      onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            updateProgress();
            syncSolid();
          });
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      updateProgress();
      syncSolid();
    }

    return () => {
      observer?.disconnect();
      if (onScroll) window.removeEventListener('scroll', onScroll);
    };
  });
</script>
