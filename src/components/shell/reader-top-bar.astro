---
// Reader-mode top bar: back button (>=44pt target), title that fades in once
// the article's own <h1> (rendered inside reader-layout's #reader-content)
// scrolls behind the bar, a slot for actions (Phase 5's bookmark button),
// and a reading-progress bar driven by `transform: scaleX()` (not `width`,
// per animation perf guidance — avoids layout/paint, GPU-composited).
import ChevronLeft from '@lucide/astro/icons/chevron-left';

interface Props {
  title: string;
  backHref: string;
  backLabel?: string;
}

const { title, backHref, backLabel = 'Quay lại' } = Astro.props;
---

<header class="rtb-bar" data-rtb-bar>
  <div class="rtb-row">
    <a href={backHref} class="rtb-back tap-scale" aria-label={backLabel}>
      <ChevronLeft size={22} stroke-width={2.5} />
      <span class="rtb-back-label">{backLabel}</span>
    </a>
    <span class="rtb-title" data-rtb-title>{title}</span>
    <div class="rtb-actions">
      <slot name="top-actions" />
    </div>
  </div>
  <div class="rtb-progress-track" aria-hidden="true">
    <div class="rtb-progress-bar" data-rtb-progress></div>
  </div>
</header>

<style>
  .rtb-bar {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top);
    background: var(--surface-veil);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border-bottom: 1px solid var(--line);
  }

  .rtb-row {
    height: var(--shell-navbar-h);
    display: grid;
    grid-template-columns: minmax(44px, auto) 1fr minmax(44px, auto);
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-2);
  }

  .rtb-back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 44px;
    padding-inline: var(--space-2);
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-body);
  }

  .rtb-back-label {
    max-width: 22vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rtb-title {
    justify-self: center;
    text-align: center;
    font-size: var(--text-body);
    font-weight: 600;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 60vw;
  }

  .rtb-bar[data-collapsed='true'] .rtb-title {
    opacity: 1;
  }

  .rtb-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 44px;
  }

  .rtb-progress-track {
    height: 2px;
    background: var(--line);
  }

  .rtb-progress-bar {
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rtb-progress-bar {
      transition: transform var(--dur-fast) linear;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-rtb-bar]');
  const progress = document.querySelector<HTMLElement>('[data-rtb-progress]');
  // reader-layout.astro wraps the slotted lesson body in <main id="reader-content">;
  // its first <h1> is the article's own "large title" that this bar's small
  // title stands in for once scrolled away.
  const articleHeading = document.querySelector<HTMLElement>('#reader-content h1');

  if (bar && articleHeading && 'IntersectionObserver' in window) {
    const navbarHeight = 44; // keep in sync with --shell-navbar-h
    const observer = new IntersectionObserver(
      ([entry]) => {
        bar.dataset.collapsed = entry.isIntersecting ? 'false' : 'true';
      },
      { rootMargin: `-${navbarHeight}px 0px 0px 0px`, threshold: 0 },
    );
    observer.observe(articleHeading);
  } else if (bar) {
    // No article heading found (shouldn't happen for real lesson content) —
    // show the title immediately rather than leaving it permanently blank.
    bar.dataset.collapsed = 'true';
  }

  if (progress) {
    let ticking = false;
    const updateProgress = () => {
      ticking = false;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    updateProgress();
  }
</script>
