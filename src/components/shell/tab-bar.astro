---
// Mobile dock (<1024px): floating, with a volt pill under the active tab. Dark
// theme = ink surface; light theme = light glass (--dock* tokens). Data comes
// from nav-items.ts (single source shared with sidebar-nav.astro). Rendered by
// app-layout.astro (always visible) and reader-layout.astro (auto-hides while
// scrolling down, see dock-autohide-binding.ts; only when body[data-shell=reader]).
// Hides while a text field elsewhere on the page has focus so the iOS keyboard
// doesn't shove it into the middle of the viewport (Tìm kiếm page).
import Icon from '../icon/icon.astro';
import { navItems, isNavItemActive } from './nav-items';

const pathname = Astro.url.pathname;
const states = navItems.map((item) => isNavItemActive(pathname, item));
const activeIndex = states.indexOf(true);
---

<nav
  class="tab-bar"
  aria-label="Điều hướng chính"
  data-tab-bar
  data-has-active={activeIndex >= 0 ? 'true' : 'false'}
  style={`--i:${Math.max(activeIndex, 0)};--tab-count:${navItems.length}`}
>
  <span class="tab-indicator" aria-hidden="true"></span>
  <ul class="tab-list">
    {navItems.map((item, i) => (
      <li>
        <a
          href={item.href}
          class="tab-link"
          aria-current={states[i] ? 'page' : undefined}
          data-active={states[i]}
        >
          <Icon name={item.icon} size={23} />
          <span class="tab-label">{item.label}</span>
          {item.href === '/da-luu' && (
            <span class="tab-badge tnum" data-saved-badge aria-hidden="true" hidden>
              0
            </span>
            <span class="sr-only" data-saved-badge-sr></span>
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tab-bar {
    position: fixed;
    left: max(14px, env(safe-area-inset-left));
    right: max(14px, env(safe-area-inset-right));
    bottom: calc(env(safe-area-inset-bottom) + var(--shell-tabbar-gap));
    max-width: 480px;
    height: var(--shell-tabbar-h);
    margin-inline: auto;
    z-index: var(--z-nav);
    padding: 6px;
    border-radius: var(--radius-dock);
    background: var(--dock-glass);
    -webkit-backdrop-filter: var(--material-blur);
    backdrop-filter: var(--material-blur);
    border: 1px solid var(--dock-line);
    box-shadow: var(--dock-shadow);
    transform: translateY(0);
    opacity: 1;
    transition:
      transform var(--dur-3) var(--ease),
      opacity var(--dur-3) var(--ease);
    view-transition-name: ol-dock;
  }

  /* data-hidden: a text field has focus (keyboard); data-scroll-hidden: reader
     auto-hide. Hidden dock is also inert (script), so it never takes focus. */
  .tab-bar[data-hidden='true'],
  .tab-bar[data-scroll-hidden='true'] {
    transform: translateY(calc(100% + env(safe-area-inset-bottom) + var(--shell-tabbar-gap) + var(--space-4)));
    opacity: 0;
    pointer-events: none;
  }

  /* Reduced motion: fade only, no slide. */
  @media (prefers-reduced-motion: reduce) {
    .tab-bar[data-hidden='true'],
    .tab-bar[data-scroll-hidden='true'] {
      transform: none;
    }
  }
  :global(:root[data-motion='reduce']) .tab-bar[data-hidden='true'],
  :global(:root[data-motion='reduce']) .tab-bar[data-scroll-hidden='true'] {
    transform: none;
  }

  /* Volt pill under the active tab; --i is the server-rendered tab index. */
  .tab-indicator {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc((100% - 12px) / var(--tab-count, 5));
    border-radius: 18px;
    background: var(--volt);
    box-shadow: var(--dock-pill-shadow);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform var(--dur-3) var(--ease);
  }

  .tab-bar[data-has-active='false'] .tab-indicator {
    display: none;
  }

  .tab-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--tab-count, 5), 1fr);
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .tab-list li {
    display: flex;
    min-width: 0;
  }

  .tab-link {
    position: relative;
    flex: 1;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 3px;
    min-width: 0;
    border-radius: 18px;
    color: var(--dock-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-2) var(--ease);
  }

  .tab-link :global(svg) {
    transition: transform var(--dur-1) var(--ease);
  }

  .tab-link:active :global(svg) {
    transform: scale(0.9);
  }

  .tab-link[data-active='true'] {
    color: var(--on-volt);
  }

  .tab-label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-nano);
    font-weight: 600;
    line-height: 1;
  }

  /* Saved-count badge (count from the progress store, see script): --dock-text
     fill with --dock text, so it contrasts on either dock material. */
  .tab-badge {
    position: absolute;
    top: 6px;
    left: calc(50% + 6px);
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--dock-text);
    color: var(--dock);
    font: 500 10px / 16px var(--font-mono);
    text-align: center;
  }

  .tab-badge[hidden] {
    display: none;
  }

  /* --dock-accent: volt on the ink dock, volt-ink on the light dock. */
  .tab-link:focus-visible {
    outline: 2px solid var(--dock-accent);
    outline-offset: -2px;
    box-shadow: none;
  }

  .tab-link[data-active='true']:focus-visible {
    outline-color: var(--on-volt);
  }

  @media (min-width: 1024px) {
    .tab-bar {
      display: none;
    }
  }
</style>

<script>
  // Hide the fixed dock while any text input/textarea elsewhere on the page
  // has focus. Re-bound on every soft navigation (onPageLoad) because the dock
  // itself is a fresh DOM node after each swap.
  import { onPageLoad } from '../../lib/page-lifecycle';
  import { bindDockAutohide } from '../../lib/dock-autohide-binding';
  import { getProgressStore } from '../../lib/progress-store';

  // Only fields that open the on-screen keyboard. Radios/checkboxes (e.g. the
  // segmented settings on /toi) take focus on tap too, and must not hide the dock.
  const NON_TEXT_INPUT_TYPES = new Set(['radio', 'checkbox', 'button', 'submit', 'reset', 'range', 'color', 'file', 'image']);
  const isTextInput = (el: EventTarget | null) =>
    el instanceof HTMLTextAreaElement || (el instanceof HTMLInputElement && !NON_TEXT_INPUT_TYPES.has(el.type));

  onPageLoad(() => {
    const bar = document.querySelector<HTMLElement>('[data-tab-bar]');
    if (!bar) return;

    const onFocusIn = (ev: FocusEvent) => {
      if (isTextInput(ev.target)) bar.dataset.hidden = 'true';
    };
    const onFocusOut = (ev: FocusEvent) => {
      if (isTextInput(ev.target)) bar.dataset.hidden = 'false';
    };

    document.addEventListener('focusin', onFocusIn);
    document.addEventListener('focusout', onFocusOut);

    // Reader pages: auto-hide on scroll down (re-bound per page; the cleanup
    // below runs on astro:before-swap so listeners never stack up).
    const stopAutohide =
      document.body.dataset.shell === 'reader' ? bindDockAutohide(bar) : undefined;

    // Saved-count badge on the "Đã lưu" tab (bookmarks.length; the lessons
    // index is not needed for a badge).
    const badge = bar.querySelector<HTMLElement>('[data-saved-badge]');
    // Spoken count lives in an sr-only suffix of the link text (not an
    // aria-label override, which would no longer contain the visible label).
    const badgeSr = bar.querySelector<HTMLElement>('[data-saved-badge-sr]');
    const unsubscribe = badge
      ? getProgressStore().subscribe((state) => {
          const n = state.bookmarks.length;
          badge.textContent = String(n);
          badge.hidden = n === 0;
          if (badgeSr) badgeSr.textContent = n > 0 ? `, ${n} bài` : '';
        })
      : undefined;

    return () => {
      document.removeEventListener('focusin', onFocusIn);
      document.removeEventListener('focusout', onFocusOut);
      stopAutohide?.();
      unsubscribe?.();
    };
  });
</script>
