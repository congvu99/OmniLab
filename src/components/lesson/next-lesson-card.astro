---
// End-of-lesson navigation card (concept ".next"): link to the next lesson
// (crossing module boundaries within the domain, see
// src/lib/content-queries.ts getAdjacent), or a "Hoàn thành lĩnh vực" card
// when there is no next lesson (domain's last lesson). Mono caps eyebrow,
// 15/700 title, volt arrow tile.
import Icon from '../icon/icon.astro';

interface Props {
  next: { href: string; title: string } | null;
  /** Where the "Hoàn thành lĩnh vực" card links back to when `next` is null. */
  domainHref: string;
  class?: string;
}

const { next, domainHref, class: className } = Astro.props;
---

{
  next ? (
    <a href={next.href} class:list={['next-lesson-card', 'tap-scale', className]}>
      <span class="next-lesson-card__text">
        <span class="next-lesson-card__eyebrow">Bài tiếp theo</span>
        <span class="next-lesson-card__title">{next.title}</span>
      </span>
      <span class="next-lesson-card__tile" aria-hidden="true">
        <Icon name="arrow-right" size={19} stroke-width={1.75} />
      </span>
    </a>
  ) : (
    <a href={domainHref} class:list={['next-lesson-card', 'tap-scale', className]}>
      <span class="next-lesson-card__text">
        <span class="next-lesson-card__eyebrow">Hết lĩnh vực</span>
        <span class="next-lesson-card__title">Hoàn thành lĩnh vực — xem lại các bài</span>
      </span>
      <span class="next-lesson-card__tile" aria-hidden="true">
        <Icon name="spark" size={19} stroke-width={1.75} />
      </span>
    </a>
  )
}

<style>
  .next-lesson-card {
    margin: 12px 0 0;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--glow);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease),
      opacity var(--dur-1) var(--ease);
  }

  @media (hover: hover) {
    .next-lesson-card:hover {
      border-color: var(--line-3);
    }

    .next-lesson-card:hover .next-lesson-card__tile {
      transform: translateX(2px);
    }
  }

  .next-lesson-card__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .next-lesson-card__eyebrow {
    font: 500 var(--text-nano) / 1.2 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .next-lesson-card__title {
    font-size: var(--text-subhead);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: var(--track-tight);
    overflow-wrap: anywhere;
  }

  .next-lesson-card__tile {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--volt);
    color: var(--on-volt);
    display: grid;
    place-items: center;
    transition: transform var(--dur-1) var(--ease);
  }
</style>
