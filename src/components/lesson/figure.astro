---
// <Figure src? alt caption? credit? added? svg?> — image or inline SVG with
// an accessible caption/credit. `alt` is always required: no decorative-only
// figures in lesson content.
//
// `added` marks a figure that is NOT from the original source (e.g. a new
// hand-drawn illustration SVG) — verify-fidelity strips these entirely,
// while figures converted from the original raw HTML <img> blocks keep their
// alt/caption/credit text counted as original content.
//
// `svg` (new, optional, backward-compatible — every existing `<Figure src=
// .../>` call keeps working untouched) takes a raw SVG string, typically
// from a Vite `?raw` import (`import xyz from '../../../../assets/
// illustrations/<domain>/<file>.svg?raw'`) and renders it inline via
// `set:html`. This is required (not just nicer) for the illustration style
// guide's rule of theming SVGs with `fill="var(--accent)"`-style presentation
// attributes: those only resolve against the page's live CSS custom
// properties (light/dark) when the <svg> is part of the document itself.
// astro:assets' <Image>/a plain <img src="*.svg"> loads the file as an
// opaque external resource with no access to the host page's CSS, so
// `var(--accent)` inside it would never resolve — confirmed against MDN/CSS
// WG guidance, see docs/illustration-style-guide.md "Inline via ?raw, not
// <img>". Each illustration SVG carries its own <title>/role="img"/
// aria-labelledby and stays a plain image in the a11y tree; zooming is a
// separate labelled overlay button (plus tap-anywhere on the diagram for
// pointer users), so the diagram never gets flattened into a button name.
import { Image } from 'astro:assets';
import Maximize2 from '@lucide/astro/icons/maximize-2';
import X from '@lucide/astro/icons/x';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  added?: boolean;
  svg?: string;
}

const { src, alt, caption, credit, added = false, svg } = Astro.props;
const isImageMetadata = typeof src === 'object' && src !== null;
---

<figure class="figure" data-added={added ? 'true' : undefined}>
  {
    svg ? (
      <div class="figure__svg" data-figure-zoom-root>
        {/* Diagram labels render ~10px on a 375px phone, so a tap opens the
            same SVG node full-screen (moved, not cloned — cloning would
            duplicate its <title>/marker ids). See figure-zoom-controller.ts. */}
        <div class="figure__svg-host" data-figure-svg-host set:html={svg} />
        <button type="button" class="figure__zoom tap-scale" data-figure-zoom aria-label="Phóng to hình">
          <Maximize2 size={16} stroke-width={2} aria-hidden="true" />
        </button>
        <dialog class="figure__dialog" data-figure-dialog aria-label={alt}>
          <div class="figure__dialog-bar">
            <button type="button" class="figure__dialog-close tap-scale" data-figure-close aria-label="Đóng hình phóng to">
              <X size={22} stroke-width={2.25} aria-hidden="true" />
            </button>
          </div>
          <div class="figure__dialog-body" data-figure-dialog-body></div>
        </dialog>
      </div>
    ) : isImageMetadata ? (
      <Image src={src as ImageMetadata} alt={alt} />
    ) : typeof src === 'string' ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <slot />
    )
  }
  {(caption || credit) && (
    <figcaption>
      {caption && <span class="figure__caption">{caption}</span>}
      {credit && <span class="figure__credit" set:html={credit} />}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: var(--space-5) 0;
  }
  /* Content images/diagrams only — a bare `.figure svg` would also hit the
     lucide icons inside the zoom/close buttons. */
  .figure :global(img),
  .figure > :global(svg),
  .figure__svg-host :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }
  /* Diagram SVGs carry their own text labels, so give them breathing room
     against a tinted panel instead of the photo-style flush border above. */
  .figure__svg {
    padding: var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .figure__svg :global(svg) {
    border: none;
    border-radius: 0;
  }
  @media (max-width: 479px) {
    /* Every px of panel padding shrinks the diagram's text further. */
    .figure__svg {
      padding: var(--space-2);
    }
  }
  .figure__svg {
    position: relative;
  }
  .figure__svg-host {
    display: block;
    cursor: zoom-in;
  }
  /* Sits in the panel's bottom-right corner, overlapping the padding more
     than the drawing; 44px hit area via ::after around a 28px chip. */
  .figure__zoom {
    position: absolute;
    right: var(--space-1);
    bottom: var(--space-1);
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
  }
  .figure__zoom::after {
    content: '';
    position: absolute;
    inset: -8px;
  }
  .figure__dialog {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--bg);
    color: var(--ink);
  }
  .figure__dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .figure__dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }
  .figure__dialog-bar {
    display: flex;
    justify-content: flex-end;
    padding: env(safe-area-inset-top) max(var(--space-2), env(safe-area-inset-right)) 0 var(--space-2);
  }
  .figure__dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }
  .figure__dialog-body {
    flex: 1;
    overflow: auto;
    overscroll-behavior: contain;
    padding: var(--space-4) var(--gutter-r) calc(var(--space-4) + env(safe-area-inset-bottom)) var(--gutter-l);
  }
  /* ~2x the phone-width rendering, so 11px labels read at ~20px; the body
     scrolls/pans on both axes when wider than the screen. */
  .figure__dialog-body :global(svg) {
    display: block;
    height: auto;
    width: max(100%, 720px);
    max-width: none;
    margin-inline: auto;
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-footnote);
    color: var(--ink-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .figure__credit :global(a) {
    color: inherit;
  }
</style>

<script>
  import { attachFigureZoom } from '../../lib/figure-zoom-controller';
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const cleanups = Array.from(document.querySelectorAll<HTMLElement>('[data-figure-zoom-root]')).map(attachFigureZoom);
    return () => cleanups.forEach((fn) => fn());
  });
</script>
