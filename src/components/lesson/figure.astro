---
// <Figure src? alt caption? credit? added?> — image or inline SVG (via
// slot) with an accessible caption/credit. `alt` is always required: no
// decorative-only figures in lesson content.
//
// `added` marks a figure that is NOT from the original source (e.g. a new
// SVG drawn for the pilot lessons in Phase 6) — verify-fidelity strips these
// entirely, while figures converted from the original raw HTML <img> blocks
// keep their alt/caption/credit text counted as original content.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  added?: boolean;
}

const { src, alt, caption, credit, added = false } = Astro.props;
const isImageMetadata = typeof src === 'object' && src !== null;
---

<figure class="figure" data-added={added ? 'true' : undefined}>
  {
    isImageMetadata ? (
      <Image src={src as ImageMetadata} alt={alt} />
    ) : typeof src === 'string' ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <slot />
    )
  }
  {(caption || credit) && (
    <figcaption>
      {caption && <span class="figure__caption">{caption}</span>}
      {credit && <span class="figure__credit" set:html={credit} />}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: var(--space-5) 0;
  }
  .figure :global(img),
  .figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-footnote);
    color: var(--ink-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .figure__credit :global(a) {
    color: inherit;
  }
</style>
