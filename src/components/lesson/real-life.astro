---
// <RealLife title?> — life example callout. This is ADDED content (never
// original translated text) so verify-fidelity removes this subtree wholesale
// when comparing a lesson against its source snapshot. See
// docs/content-authoring-guide.md for the writing rules and usage pattern.
//
// Draft badge: while a lesson's `examplesReviewed` frontmatter is still
// `false`, the reader page ([slug].astro) sets
// `data-examples-reviewed="false"` on an ancestor of the article body. We
// key the "Nháp" badge off that attribute with a pure-CSS descendant
// selector (no JS, no prop) so the badge automatically disappears the
// moment a content reviewer flips `examplesReviewed: true` in
// frontmatter — nothing here needs to change when that happens.
import Lightbulb from '@lucide/astro/icons/lightbulb';

interface Props {
  title?: string;
}
const { title = 'Ví dụ đời sống' } = Astro.props;
---

<aside class="real-life">
  <p class="real-life__title">
    <Lightbulb size={16} stroke-width={2} aria-hidden="true" class="real-life__icon" />
    <span>{title}</span>
    <span class="real-life__badge">Nháp</span>
  </p>
  <div class="real-life__body">
    <slot />
  </div>
</aside>

<style>
  .real-life {
    margin: var(--space-5) 0;
    padding: var(--space-4);
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
    border-radius: var(--radius-card);
  }
  .real-life__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-weight: 700;
    font-size: var(--text-footnote);
    color: var(--accent);
  }
  .real-life__icon {
    flex: none;
    color: var(--accent);
  }
  .real-life__badge {
    display: none;
    flex: none;
    margin-left: auto;
    padding: 2px var(--space-2);
    font-size: 12px; /* 12px floor for any text */
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent-on);
    background: var(--accent);
    border-radius: var(--radius-full);
  }
  /* Ancestor set by the reader page while examplesReviewed: false — see
     comment above. */
  :global([data-examples-reviewed='false']) .real-life .real-life__badge {
    display: inline-block;
  }
  .real-life__body {
    color: var(--ink);
  }
  .real-life__body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
