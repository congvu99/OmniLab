---
// <RealLife title?> — life example callout (concept ".reallife"). This is ADDED
// content (never original translated text) so verify-fidelity removes this
// subtree wholesale when comparing a lesson against its source snapshot. See
// docs/content-authoring-guide.md for the writing rules and usage pattern.
//
// Layout: mono caps tag "Ví dụ đời sống" (+ "Nháp" badge), the example's own
// title as a 16/700 line (a <p>, not a heading, so it never breaks the
// lesson's heading outline), then the body. The tint follows the domain accent.
//
// Draft badge: while a lesson's `examplesReviewed` frontmatter is still
// `false`, the reader page ([slug].astro) sets
// `data-examples-reviewed="false"` on an ancestor of the article body. We
// key the "Nháp" badge off that attribute with a pure-CSS descendant
// selector (no JS, no prop) so the badge automatically disappears the
// moment a content reviewer flips `examplesReviewed: true` in
// frontmatter — nothing here needs to change when that happens.
import Icon from '../icon/icon.astro';

interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="real-life" aria-label={title ? `Ví dụ đời sống: ${title}` : 'Ví dụ đời sống'}>
  <p class="real-life__tag">
    <Icon name="bulb" size={16} stroke-width={1.75} aria-hidden="true" />
    <span>Ví dụ đời sống</span>
    <span class="real-life__badge">Nháp</span>
  </p>
  {title && <p class="real-life__title">{title}</p>}
  <div class="real-life__body">
    <slot />
  </div>
</aside>

<style>
  .real-life {
    position: relative;
    margin: 20px 0;
    padding: 18px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: var(--glow);
    font-size: var(--text-subhead);
    line-height: 1.65;
    color: var(--text-2);
  }

  @supports (color: color-mix(in srgb, red 50%, blue)) {
    .real-life {
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, var(--surface)), var(--surface));
      border-color: color-mix(in srgb, var(--accent) 26%, transparent);
    }
  }

  .real-life__tag {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    font: 500 var(--text-nano) / 1 var(--font-mono);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  .real-life__badge {
    display: none;
    margin-left: auto;
    padding: 3px 7px;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--accent-on);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  /* Ancestor set by the reader page while examplesReviewed: false — see
     comment above. */
  :global([data-examples-reviewed='false']) .real-life .real-life__badge {
    display: inline-block;
  }

  .real-life__title {
    margin: 0 0 6px;
    font-size: var(--text-callout);
    font-weight: 700;
    letter-spacing: var(--track-tight);
    line-height: 1.35;
    color: var(--text);
  }

  div.real-life__body :global(p) {
    margin: 0 0 10px;
    font-size: inherit;
  }

  div.real-life__body :global(> :last-child) {
    margin-bottom: 0;
  }

  div.real-life__body :global(strong) {
    color: var(--text);
  }
</style>
