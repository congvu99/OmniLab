---
// End-of-lesson source/license attribution — required on every lesson
// ("Mỗi bài hiển thị nguồn + license").
import Icon from '../icon/icon.astro';

interface Props {
  sourceName: string;
  author: string;
  license: string;
  url?: string;
}

const { sourceName, author, license, url } = Astro.props;
---

<footer class="attribution-footer">
  <p>
    <strong>Nguồn:</strong> {sourceName} — {author}
  </p>
  <p><strong>Giấy phép:</strong> {license}</p>
  {
    url && (
      <p>
        <a href={url} target="_blank" rel="noopener noreferrer">
          Xem bản gốc
          <Icon name="external" size={14} stroke-width={2} aria-hidden="true" />
        </a>
      </p>
    )
  }
</footer>

<style>
  /* Quiet ruled footer: provenance is required but must not compete with the
     completion card below it. */
  .attribution-footer {
    margin: 36px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--line);
    font: 400 var(--text-label) / 1.6 var(--font-mono);
    color: var(--text-3);
  }

  .attribution-footer p {
    margin: 0 0 2px;
  }

  .attribution-footer strong {
    font-weight: 500;
    color: var(--text-2);
  }

  .attribution-footer a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--volt-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (hover: hover) {
    .attribution-footer a:hover {
      color: var(--text);
    }
  }
</style>
