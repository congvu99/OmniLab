---
// Concept ".by" strip under the lesson header: reading time, source + license
// (shortened here; the full credit sits in the lesson footer) and (only when the editorial pass is done) "Đã soát ví dụ". Mono 11.5px on
// hairline rules above and below.
import Icon from '../icon/icon.astro';
import { shortLicenseLabel, shortSourceLabel } from '../../lib/lesson-reader-model';

interface Props {
  readingMinutes: number;
  sourceName: string;
  license: string;
  examplesReviewed: boolean;
}

const { readingMinutes, sourceName, license, examplesReviewed } = Astro.props;
---

<ul class="lesson-meta">
  <li>
    <Icon name="clock" size={14} stroke-width={1.75} aria-hidden="true" />
    <span class="tnum">{readingMinutes} phút đọc</span>
  </li>
  <li>
    <Icon name="doc" size={14} stroke-width={1.75} aria-hidden="true" />
    <span>{shortSourceLabel(sourceName)} · {shortLicenseLabel(license)}</span>
  </li>
  {
    examplesReviewed && (
      <li>
        <Icon name="check-circle" size={14} stroke-width={1.75} aria-hidden="true" />
        <span>Đã soát ví dụ</span>
      </li>
    )
  }
</ul>

<style>
  .lesson-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 16px 0 0;
    padding: 12px 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font: 500 var(--text-label) / 1.4 var(--font-mono);
    color: var(--text-3);
  }

  .lesson-meta li {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .lesson-meta span {
    overflow-wrap: anywhere;
  }
</style>
