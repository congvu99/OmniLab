---
// Collapsible table of contents from a lesson's h2 headings, using native
// <details>/<summary> — no JS needed for collapse/expand.
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <details class="lesson-toc">
      <summary>Mục lục</summary>
      <ol>
        {headings.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .lesson-toc {
    margin: 0 0 var(--space-5);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-2);
    border-radius: var(--radius-row);
  }

  .lesson-toc summary {
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-footnote);
    color: var(--ink);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .lesson-toc ol {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-5);
  }

  .lesson-toc li {
    margin-bottom: 0;
    font-size: var(--text-footnote);
  }

  .lesson-toc li:last-child {
    margin-bottom: 0;
  }

  .lesson-toc a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    /* Block + vertical padding: each entry is a standalone target (not
       running text), so it gets a >=44px-tall hit area. */
    display: block;
    padding-block: 10px;
  }
</style>
