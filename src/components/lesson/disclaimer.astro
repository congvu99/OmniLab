---
// <Disclaimer> — added content, rendered at the top of every lesson in a
// domain with `isFinance: true` (wired by the reader page,
// src/pages/hoc/[domain]/[module]/[slug].astro). Not part of the original
// source: verify-fidelity strips this subtree entirely.
// Concept ".note" treatment with the info glyph, so it reads as a quiet
// caution rather than an alarm.
import Icon from '../icon/icon.astro';
---

<div class="disclaimer" role="note">
  <Icon name="info" size={20} stroke-width={1.75} aria-hidden="true" class="disclaimer__icon" />
  <p>
    <strong>Miễn trừ trách nhiệm:</strong> nội dung mang tính giáo dục, không
    phải tư vấn đầu tư hay khuyến nghị mua/bán sản phẩm tài chính cụ thể.
    Kiểm tra lại số liệu, quy định pháp luật và điều kiện sản phẩm tại nguồn
    chính thức trước khi quyết định.
  </p>
</div>

<style>
  .disclaimer {
    display: flex;
    gap: 12px;
    margin: 20px 0;
    padding: 14px 16px;
    border-radius: var(--radius-row);
    border: 1px solid var(--line-2);
    background: var(--surface-2);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--text-2);
  }

  .disclaimer__icon {
    flex: none;
    align-self: flex-start;
    margin-top: 1px;
    color: var(--text);
  }

  .disclaimer strong {
    color: var(--text);
  }

  .disclaimer p {
    margin: 0;
  }
</style>
