---
// <Note title?> — generic callout box. Used both for original content boxes
// converted 1:1 (finance ".note"/".box"/".warm" divs — text stays original,
// so verify-fidelity keeps it) and for any future added notes.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="note">
  {title && <p class="note__title">{title}</p>}
  <div class="note__body">
    <slot />
  </div>
</div>

<style>
  .note {
    margin: var(--space-5) 0;
    padding: var(--space-4);
    background: var(--surface-2);
    border-left: 4px solid var(--accent);
    border-radius: 0 var(--radius-row) var(--radius-row) 0;
  }
  .note__title {
    margin: 0 0 var(--space-2);
    font-weight: 700;
    font-size: var(--text-footnote);
  }
  .note__body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
