---
// Renders into `/da-luu`'s body — bookmarked lessons with a remove action,
// or an empty state explaining how to bookmark. Both states + the row
// template are server-rendered (see mark-complete-button.astro's header
// comment re: why client JS here only clones/mutates, never builds HTML
// from scratch).
import Bookmark from '@lucide/astro/icons/bookmark';
import X from '@lucide/astro/icons/x';
---

<div data-saved-list>
  <!-- Loading state (default): with bookmarks present, the lessons index
       must load before rows can render — without this the empty state
       would flash first. No bookmarks → controller swaps to the empty state
       synchronously, so the skeleton never shows for that case. -->
  <div class="saved-skeleton" data-saved-loading>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="sr-only">Đang tải bài đã lưu…</span>
  </div>

  <div class="empty-state" data-saved-empty tabindex="-1" hidden>
    <Bookmark size={40} stroke-width={1.75} aria-hidden="true" />
    <p class="empty-title">Chưa có bài đã lưu</p>
    <p class="empty-body">
      Mở một bài học, nhấn biểu tượng lưu ở đầu trang để thêm bài vào đây.
    </p>
  </div>

  <ul class="saved-rows" data-saved-rows hidden></ul>

  <template data-saved-row-template>
    <li class="saved-row">
      <a class="saved-row__link" data-saved-row-link>
        <span class="saved-row__title" data-saved-row-title></span>
        <span class="saved-row__domain" data-saved-row-domain></span>
      </a>
      <button type="button" class="saved-row__remove tap-scale" data-saved-row-remove aria-label="Bỏ lưu bài này">
        <X size={18} stroke-width={2} aria-hidden="true" />
      </button>
    </li>
  </template>
</div>

<style>
  /* See mark-complete-button.astro's [hidden] comment. */
  .empty-state[hidden] {
    display: none;
  }

  .empty-state {
    margin: var(--space-6) var(--space-4);
    padding: var(--space-6) var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    color: var(--ink-2);
  }

  .empty-title {
    font-size: var(--text-title3);
    font-weight: 700;
    color: var(--ink);
  }

  .empty-body {
    max-width: 32ch;
  }

  .saved-skeleton[hidden] {
    display: none;
  }

  .saved-skeleton {
    margin: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Matches a real row's 44px min tap height minus its vertical padding. */
  .saved-skeleton__row {
    height: 40px;
  }

  .saved-rows {
    margin: var(--space-4);
    padding: 0;
    list-style: none;
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .saved-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .saved-row:last-child {
    border-bottom: none;
  }

  .saved-row__link {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 44px;
    justify-content: center;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .saved-row__link:hover,
    .saved-row__remove:hover {
      background: var(--surface-2);
    }
  }

  .saved-row__title {
    font-size: var(--text-body);
    color: var(--ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .saved-row__domain {
    font-size: var(--text-caption);
    color: var(--ink-2);
  }

  .saved-row__remove {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-2);
    margin-right: var(--space-2);
    border-radius: var(--radius-row);
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { fetchLessonsIndex } from '../../lib/lessons-index-client';
  import { attachSavedList, readSavedListElements } from '../../lib/saved-list-controller';
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-saved-list]');
    const els = root && readSavedListElements(root);
    if (!els) return;

    return attachSavedList(els, getProgressStore(), fetchLessonsIndex);
  });
</script>
