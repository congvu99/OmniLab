---
// Renders into `/da-luu`'s body — bookmarked lessons with a remove action,
// or an empty state explaining how to bookmark. Both states + the row
// template are server-rendered (see mark-complete-button.astro's header
// comment re: why client JS here only clones/mutates, never builds HTML
// from scratch). Rows follow the concept: mono index, title, "■ domain · N
// phút" meta, and a 44px remove button.
//
// `meta` (serialized DomainMeta[]) tints each row with its domain hue.
import Icon from '../icon/icon.astro';
import { serializeDomainMeta, type DomainMeta } from '../../lib/domain-meta';

interface Props {
  meta?: DomainMeta[];
}

const { meta = [] } = Astro.props;
---

<div class="saved-wrap" data-saved-list data-meta={serializeDomainMeta(meta)}>
  <!-- Loading state (default): with bookmarks present, the lessons index
       must load before rows can render — without this the empty state
       would flash first. No bookmarks → controller swaps to the empty state
       synchronously, so the skeleton never shows for that case. -->
  <div class="saved-skeleton" data-saved-loading>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="skeleton saved-skeleton__row"></span>
    <span class="sr-only">Đang tải bài đã lưu…</span>
  </div>

  <div class="empty-state" data-saved-empty tabindex="-1" hidden>
    <span class="eic"><Icon name="bookmark" size={28} aria-hidden="true" /></span>
    <p class="empty-title">Chưa lưu bài nào</p>
    <p class="empty-body">Trong lúc đọc, chạm biểu tượng lưu ở góc trên để giữ bài lại đây.</p>
    <a href="/linh-vuc" class="btn btn-secondary btn-sm">Khám phá lĩnh vực</a>
  </div>

  <ul class="rows rows--idx saved-rows" data-saved-rows hidden></ul>

  <template data-saved-row-template>
    <li class="saved-row rise">
      <a class="row saved-row__link hue" data-saved-row-link>
        <span class="idx tnum" data-saved-row-index></span>
        <span class="tt">
          <b data-saved-row-title></b>
          <small class="tnum"><span class="sq" aria-hidden="true"></span><span data-saved-row-domain></span><span data-saved-row-minutes></span></small>
        </span>
      </a>
      <button type="button" class="btn btn-ghost btn-icon btn-sm saved-row__remove" data-saved-row-remove aria-label="Bỏ lưu bài này">
        <Icon name="close" size={18} aria-hidden="true" />
      </button>
    </li>
  </template>
</div>

<style>
  .saved-wrap {
    max-width: 760px;
  }

  /* See mark-complete-button.astro's [hidden] comment. */
  .empty-state[hidden],
  .saved-skeleton[hidden],
  .saved-rows[hidden] {
    display: none;
  }

  .empty-state {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 48px 32px;
    text-align: center;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .eic {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px dashed var(--line-3);
    border-radius: var(--radius-xl);
    color: var(--text-3);
  }

  .empty-title {
    font-size: var(--text-callout);
    font-weight: 700;
    color: var(--text);
  }

  .empty-body {
    max-width: 32ch;
    margin-bottom: 4px;
    line-height: var(--leading-normal);
  }

  .saved-skeleton {
    display: grid;
    gap: var(--space-3);
    padding-inline: var(--gutter-l) var(--gutter-r);
  }

  .saved-skeleton__row {
    height: 56px;
    border-radius: var(--radius-row);
  }

  .saved-rows {
    --inset: 50px;
    margin-inline: calc(var(--gutter-l) - 12px) calc(var(--gutter-r) - 12px);
  }

  .saved-row {
    display: flex;
    align-items: center;
  }

  .saved-row__link {
    flex: 1;
    min-width: 0;
  }

  .saved-row__link :global(.tt b) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .sq {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 2px;
    background: var(--c);
  }

  .saved-row__remove {
    --h: 44px;
    flex: none;
    margin-right: 4px;
    color: var(--text-3);
  }

  @media (min-width: 1024px) {
    .saved-rows {
      --inset: 56px;
      margin: 0 var(--gutter-r) 0 var(--gutter-l);
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--surface);
    }

    .saved-rows :global(.row:focus-visible),
    .saved-rows :global(.btn:focus-visible) {
      outline-offset: -2px;
      box-shadow: none;
    }
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { fetchLessonsIndex } from '../../lib/lessons-index-client';
  import { attachSavedList, readSavedListElements } from '../../lib/saved-list-controller';
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-saved-list]');
    const els = root && readSavedListElements(root);
    if (!els) return;

    return attachSavedList(els, getProgressStore(), fetchLessonsIndex);
  });
</script>
