---
// Shared SVG "% complete" ring markup — used by both domain-card.astro and
// domain-hero.astro. Purely presentational + static (0%) at server-render
// time; this component's own bootstrap <script> below fills in the real
// ratio client-side by reading this exact DOM shape. Astro hoists/dedupes
// identical component <script> content, so the script runs once per page
// no matter how many progress-ring instances render on it (domain-card can
// render several). `role="img"` + `aria-label` (set by the script) carries
// the info for screen readers; the "%" text inside the ring (and, when
// `showFraction`, the "x/y bài" text beside it) means sighted users never
// rely on color alone.
//
// `showFraction` lives on this shared component (rather than being
// duplicated per call-site) so the bootstrap script can query for
// `[data-progress-ring-fraction]` uniformly regardless of which page/variant
// it's decorating.
interface Props {
  domainId: string;
  size?: number;
  showFraction?: boolean;
}

const { domainId, size = 32, showFraction = false } = Astro.props;
const strokeWidth = size <= 40 ? 3 : 4;
const radius = size / 2 - strokeWidth * 1.5;
const center = size / 2;
const fontSize = Math.max(10, Math.round(size * 0.26));
---

<span
  class="progress-ring-slot"
  data-domain={domainId}
  data-progress-ring
  data-show-fraction={showFraction ? 'true' : 'false'}
  role="img"
  aria-label="Chưa bắt đầu"
>
  <span class="progress-ring-circle" style={`--size:${size}px`}>
    <svg class="progress-ring-svg" viewBox={`0 0 ${size} ${size}`} width={size} height={size} aria-hidden="true">
      <circle cx={center} cy={center} r={radius} fill="none" stroke="var(--line)" stroke-width={strokeWidth} />
      <circle
        cx={center}
        cy={center}
        r={radius}
        fill="none"
        stroke="var(--card-accent, var(--accent))"
        stroke-width={strokeWidth}
        stroke-linecap="round"
        transform={`rotate(-90 ${center} ${center})`}
        data-progress-ring-fill
      />
    </svg>
    <span class="progress-ring-text" style={`--ring-font-size:${fontSize}px`} data-progress-ring-text aria-hidden="true"
    ></span>
  </span>
  {showFraction && <span class="progress-ring-fraction" data-progress-ring-fraction aria-hidden="true" />}
</span>

<style>
  .progress-ring-slot {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .progress-ring-circle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    flex-shrink: 0;
  }

  .progress-ring-svg circle {
    transition: stroke-dashoffset var(--dur) var(--ease-out);
  }

  .progress-ring-text {
    position: absolute;
    font-size: var(--ring-font-size);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .progress-ring-fraction {
    font-size: var(--text-footnote);
    color: var(--ink-2);
  }
</style>

<script>
  // Fills in every `.progress-ring-slot` on the page (there may be several —
  // one per progress-ring instance, e.g. several domain-card rows on
  // /linh-vuc) with the real % done.
  import { getProgressStore } from '../../lib/progress-store';
  import { fetchLessonsIndex } from '../../lib/lessons-index-client';
  import { applyProgressRing } from '../../lib/progress-ring-apply';
  import { onPageLoad } from '../../lib/page-lifecycle';

  onPageLoad(() => {
    const rings = Array.from(document.querySelectorAll<HTMLElement>('.progress-ring-slot[data-progress-ring]'));
    if (rings.length === 0) return;

    // `fetchLessonsIndex()` is async, so a navigation can happen before it
    // resolves; `cancelled` discards a stale resolution instead of
    // subscribing rings that already got torn down (previously: an
    // in-flight `init()` could resume after a *later* init's own
    // `unsubscribe()` already ran, re-subscribing detached rings and
    // clobbering `unsubscribe` — a leaked subscription that lived for the
    // rest of the session).
    let cancelled = false;
    let unsubscribe: (() => void) | undefined;

    void (async () => {
      let lessons;
      try {
        lessons = await fetchLessonsIndex();
      } catch {
        return; // stays at the static server-rendered 0% ring — acceptable degradation
      }
      if (cancelled) return;

      const store = getProgressStore();
      unsubscribe = store.subscribe((state) => {
        for (const ring of rings) applyProgressRing(ring, state, lessons);
      });
    })();

    return () => {
      cancelled = true;
      unsubscribe?.();
    };
  });
</script>
