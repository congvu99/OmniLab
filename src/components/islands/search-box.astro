---
// Renders into `/tim-kiem`'s body — debounced full-text search over
// /search-index.json via MiniSearch (see src/lib/search-index.ts + phase-05
// report for why MiniSearch was chosen over Pagefind). All states (hint,
// loading, error, empty, results) are server-rendered and toggled via
// [hidden] — see mark-complete-button.astro's header comment for why.
import Search from '@lucide/astro/icons/search';
import LoaderCircle from '@lucide/astro/icons/loader-circle';
import Inbox from '@lucide/astro/icons/inbox';
import WifiOff from '@lucide/astro/icons/wifi-off';
---

<div class="search-shell" data-search>
  <label class="search-field" for="search-input">
    <Search size={20} stroke-width={2} aria-hidden="true" />
    <input
      id="search-input"
      type="search"
      name="q"
      placeholder="Tìm bài học, ví dụ: cache, bộ nhớ đệm..."
      autocomplete="off"
      enterkeyhint="search"
      data-search-input
    />
  </label>

  <p class="search-status" data-search-hint>Gõ để tìm — hỗ trợ gõ không dấu, ví dụ "bo nho dem".</p>
  <p class="search-status" data-search-loading hidden aria-live="polite">
    <LoaderCircle size={16} stroke-width={2} class="search-spin" aria-hidden="true" /> Đang tìm...
  </p>
  <p class="search-status" data-search-error hidden>
    <WifiOff size={18} stroke-width={2} aria-hidden="true" /> Không tải được dữ liệu tìm kiếm. Thử lại sau.
  </p>
  <p class="search-status" data-search-empty hidden>
    <Inbox size={18} stroke-width={2} aria-hidden="true" /> Không tìm thấy kết quả phù hợp.
  </p>

  <ul class="search-results" data-search-results hidden aria-live="polite"></ul>

  <template data-search-result-template>
    <li class="search-result">
      <a class="search-result__link tap-scale" data-search-result-link>
        <span class="search-result__title" data-search-result-title></span>
        <span class="search-result__domain" data-search-result-domain></span>
        <span class="search-result__snippet" data-search-result-snippet></span>
      </a>
    </li>
  </template>
</div>

<style>
  .search-shell {
    margin: var(--space-4);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-row);
    color: var(--ink-2);
  }

  .search-field input {
    flex: 1;
    min-height: 44px;
    border: none;
    background: none;
    font-size: var(--text-body);
    color: var(--ink);
  }

  .search-field input::placeholder {
    color: var(--ink-2);
  }

  .search-field input:focus {
    outline: none;
  }

  .search-field:focus-within {
    border-color: var(--accent);
  }

  /* See mark-complete-button.astro's [hidden] comment. */
  .search-status[hidden],
  .search-results[hidden] {
    display: none;
  }

  .search-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-footnote);
    color: var(--ink-2);
    text-align: center;
    justify-content: center;
  }

  .search-spin {
    animation: search-spin 0.8s linear infinite;
  }

  @keyframes search-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .search-results {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .search-result__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-row);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    min-height: 44px;
  }

  .search-result__title {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--ink);
  }

  .search-result__domain {
    display: inline-block;
    align-self: flex-start;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--domain-kien-truc-accent);
  }

  .search-result__domain[data-domain='tai-chinh'] {
    color: var(--domain-tai-chinh-accent);
  }

  @media (prefers-color-scheme: dark) {
    .search-result__domain {
      color: var(--domain-kien-truc-accent-dark);
    }

    .search-result__domain[data-domain='tai-chinh'] {
      color: var(--domain-tai-chinh-accent-dark);
    }
  }

  .search-result__snippet {
    font-size: var(--text-footnote);
    color: var(--ink-2);
  }

  .search-result__snippet :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  import { attachSearchBox, readSearchBoxElements } from '../../lib/search-box-controller';

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;

    const root = document.querySelector<HTMLElement>('[data-search]');
    const els = root && readSearchBoxElements(root);
    if (!els) return;

    cleanup = attachSearchBox(els);
  }

  document.addEventListener('astro:page-load', init);
</script>
