---
// Renders into `/tim-kiem`'s body — debounced full-text search over
// /search-index.json via MiniSearch (see src/lib/search-index.ts and
// docs/system-architecture.md "Tìm kiếm" for why MiniSearch was chosen over
// Pagefind: Pagefind's own Vietnamese folding missed the target lesson for
// a fully-unaccented query). All states (hint, loading, error, empty,
// results) are server-rendered and toggled via [hidden] — see
// mark-complete-button.astro's header comment for why.
import Search from '@lucide/astro/icons/search';
import LoaderCircle from '@lucide/astro/icons/loader-circle';
import Inbox from '@lucide/astro/icons/inbox';
import WifiOff from '@lucide/astro/icons/wifi-off';
---

<div class="search-shell" data-search>
  <label class="search-field" for="search-input">
    <Search size={20} stroke-width={2} aria-hidden="true" />
    <span class="sr-only">Tìm kiếm bài học</span>
    <input
      id="search-input"
      type="search"
      name="q"
      placeholder="Tìm bài học, ví dụ: cache, bộ nhớ đệm..."
      autocomplete="off"
      enterkeyhint="search"
      data-search-input
    />
  </label>

  <p class="search-status" data-search-hint>Gõ để tìm — hỗ trợ gõ không dấu, ví dụ "bo nho dem".</p>
  <!-- Announced via the result-count status region below (a region that
       toggles [hidden] and text in one tick is not reliably announced). -->
  <p class="search-status" data-search-loading hidden>
    <LoaderCircle size={16} stroke-width={2} class="search-spin" aria-hidden="true" /> Đang tìm...
  </p>
  <p class="search-status" data-search-error hidden>
    <WifiOff size={18} stroke-width={2} aria-hidden="true" /> Không tải được dữ liệu tìm kiếm.
    <button type="button" class="search-retry tap-scale" data-search-retry>Thử lại</button>
  </p>
  <p class="search-status" data-search-empty hidden>
    <Inbox size={18} stroke-width={2} aria-hidden="true" /> Không tìm thấy kết quả phù hợp.
  </p>

  <!-- One concise status announcement ("N kết quả") instead of aria-live on
       the whole list below — the list can render many rows per keystroke,
       which would otherwise have a screen reader read out every title,
       domain and snippet on every result set. -->
  <p class="sr-only" role="status" aria-live="polite" data-search-result-count></p>
  <ul class="search-results" data-search-results hidden></ul>

  <template data-search-result-template>
    <li class="search-result">
      <a class="search-result__link tap-scale" data-search-result-link>
        <span class="search-result__title" data-search-result-title></span>
        <span class="search-result__domain" data-search-result-domain></span>
        <span class="search-result__snippet" data-search-result-snippet></span>
      </a>
    </li>
  </template>
</div>

<style>
  .search-shell {
    margin: var(--space-4);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-row);
    color: var(--ink-2);
  }

  .search-field input {
    flex: 1;
    min-height: 44px;
    border: none;
    background: none;
    font-size: var(--text-body);
    color: var(--ink);
  }

  .search-field input::placeholder {
    color: var(--ink-2);
  }

  /* Suppress the outline for a mouse/touch click (no visible keyboard focus
     ring needed there — the border-color change below is enough), but keep
     it for real keyboard focus (:focus-visible) — a border-color-only
     change is not a strong enough focus indicator on its own for keyboard
     users. */
  .search-field input:focus:not(:focus-visible) {
    outline: none;
  }

  .search-field:focus-within {
    border-color: var(--accent);
  }

  /* See mark-complete-button.astro's [hidden] comment. */
  .search-status[hidden],
  .search-results[hidden] {
    display: none;
  }

  .search-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-footnote);
    color: var(--ink-2);
    text-align: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  .search-retry {
    min-height: 44px;
    padding-inline: var(--space-2);
    font-weight: 700;
    color: var(--accent);
  }

  .search-spin {
    animation: search-spin 0.8s linear infinite;
  }

  @keyframes search-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .search-results {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .search-result__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-row);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .search-result__link:hover {
      background: var(--surface-2);
    }
  }

  .search-result__title {
    font-size: var(--text-body);
    font-weight: 700;
    color: var(--ink);
  }

  /* Colored via --card-accent/--card-accent-dark, set inline on the row's
     <a> by search-box-controller.ts from that lesson's own domain metadata
     (search-index.json's domainAccent/domainAccentDark). Falls back to the
     default accent token so a result row still looks correct before that
     inline style is applied (e.g. a domain with no accent color, which
     shouldn't happen but must not render invisible/unstyled text). */
  .search-result__domain {
    display: inline-block;
    align-self: flex-start;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--card-accent, var(--accent));
  }

  @media (prefers-color-scheme: dark) {
    .search-result__domain {
      color: var(--card-accent-dark, var(--accent));
    }
  }

  .search-result__snippet {
    font-size: var(--text-footnote);
    color: var(--ink-2);
  }

  .search-result__snippet :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  import { attachSearchBox, readSearchBoxElements } from '../../lib/search-box-controller';

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;

    const root = document.querySelector<HTMLElement>('[data-search]');
    const els = root && readSearchBoxElements(root);
    if (!els) return;

    cleanup = attachSearchBox(els);
  }

  document.addEventListener('astro:page-load', init);
</script>
