---
// "Dữ liệu & ứng dụng" status rows on /toi: whether progress survives a reload
// (progress-store isPersistent, wording in storage-status-copy.ts) and the
// home-screen install tip, shown only on iPhone/iPad outside the installed
// app. Server HTML is the neutral default (tip hidden, so other platforms
// never flash it); the script fills in the real state on the client.
import Icon from '../icon/icon.astro';
---

<ul class="rows rows--plain" data-storage-panel>
  <li>
    <div class="row">
      <span class="dom-ic"><Icon name="info" size={21} /></span>
      <div class="tt">
        <b data-storage-title>Lưu trữ trên máy này</b>
        <small class="ss__wrap" data-storage-detail>Đang kiểm tra…</small>
      </div>
    </div>
  </li>
  <li data-install-hint hidden>
    <div class="row">
      <span class="dom-ic"><Icon name="domains" size={21} /></span>
      <div class="tt">
        <b>Cài lên màn hình chính</b>
        <small class="ss__wrap">
          Trên iPhone/iPad: bấm Chia sẻ, rồi chọn “Thêm vào Màn hình chính”. Tiến độ sẽ không bị Safari tự xoá.
        </small>
      </div>
    </div>
  </li>
</ul>

<style>
  .rows--plain {
    margin: 0 -8px;
  }

  /* Status text wraps (the shared .row small is a single ellipsized line). */
  .rows--plain .tt small.ss__wrap {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  [data-install-hint][hidden] {
    display: none;
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { onPageLoad } from '../../lib/page-lifecycle';
  import { isIosDevice, isStandaloneApp } from '../../lib/ios-hint';
  import { storageStatusCopy } from '../../lib/storage-status-copy';

  onPageLoad(() => {
    const panel = document.querySelector<HTMLElement>('[data-storage-panel]');
    if (!panel) return;
    const title = panel.querySelector<HTMLElement>('[data-storage-title]');
    const detail = panel.querySelector<HTMLElement>('[data-storage-detail]');
    const install = panel.querySelector<HTMLElement>('[data-install-hint]');

    const ios = isIosDevice();
    const standalone = isStandaloneApp();
    if (title && detail) {
      const copy = storageStatusCopy({ persistent: getProgressStore().isPersistent, ios, standalone });
      title.textContent = copy.title;
      detail.textContent = copy.detail;
    }
    if (install) install.hidden = !ios || standalone;
  });
</script>
