---
// Toggle button for `.lesson-complete-slot` (rendered by the reader page,
// [slug].astro). Both icon states + the undo toast are server-rendered
// (hidden via CSS/[hidden]) so the client script only ever mutates
// attributes/text — no innerHTML/createElement, so Astro's scoped <style>
// below applies correctly to every state (creating DOM client-side instead
// would render outside Astro's per-component style scoping).
import Circle from '@lucide/astro/icons/circle';
import CircleCheck from '@lucide/astro/icons/circle-check';

interface Props {
  lessonId: string;
}

const { lessonId } = Astro.props;
---

<div class="mcb" data-mcb data-lesson-id={lessonId} data-done="false">
  <button
    type="button"
    class="mcb-button tap-scale"
    data-mcb-button
    aria-pressed="false"
    aria-label="Đánh dấu hoàn thành bài học"
  >
    <Circle size={20} stroke-width={2} aria-hidden="true" class="mcb-icon mcb-icon--todo" />
    <CircleCheck size={20} stroke-width={2} aria-hidden="true" class="mcb-icon mcb-icon--done" />
    <span data-mcb-label aria-hidden="true">Đánh dấu hoàn thành</span>
  </button>
  <div class="mcb-toast" data-mcb-toast hidden>
    <span data-mcb-toast-text></span>
    <button type="button" class="mcb-undo tap-scale" data-mcb-undo>Hoàn tác</button>
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-mcb-announce></span>
</div>

<style>
  .mcb {
    margin: var(--space-6) 0 0;
  }

  .mcb-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-row);
    background: var(--surface-2);
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: 600;
  }

  .mcb[data-done='true'] .mcb-button {
    background: var(--accent);
    color: var(--accent-on);
  }

  .mcb-icon--done {
    display: none;
  }

  .mcb[data-done='true'] .mcb-icon--todo {
    display: none;
  }

  .mcb[data-done='true'] .mcb-icon--done {
    display: block;
  }

  /* [hidden] and an unconditional `display` on the same element are equal
     specificity, and author styles win cascade ties over the UA stylesheet
     — so `display: flex` below would silently defeat `.hidden = true`
     without this explicit override (found via real-browser testing, not
     just static CSS reasoning). The same fix is applied to every other
     hidden-toggled element with a non-default `display` across this
     codebase's islands. */
  .mcb-toast[hidden] {
    display: none;
  }

  .mcb-toast {
    margin-top: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-row);
    font-size: var(--text-footnote);
    color: var(--ink);
  }

  .mcb-undo {
    flex-shrink: 0;
    min-height: 44px;
    padding-inline: var(--space-2);
    font-weight: 700;
    color: var(--accent);
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';

  const TOAST_DURATION_MS = 4000;
  let unsubscribe: (() => void) | null = null;

  function init() {
    unsubscribe?.();
    unsubscribe = null;

    const root = document.querySelector<HTMLElement>('[data-mcb]');
    const lessonId = root?.dataset.lessonId;
    if (!root || !lessonId) return;

    const button = root.querySelector<HTMLButtonElement>('[data-mcb-button]');
    const label = root.querySelector<HTMLElement>('[data-mcb-label]');
    const toast = root.querySelector<HTMLElement>('[data-mcb-toast]');
    const toastText = root.querySelector<HTMLElement>('[data-mcb-toast-text]');
    const undoButton = root.querySelector<HTMLButtonElement>('[data-mcb-undo]');
    const announce = root.querySelector<HTMLElement>('[data-mcb-announce]');
    if (!button || !label || !toast || !toastText || !undoButton || !announce) return;

    const store = getProgressStore();
    let toastTimer: ReturnType<typeof setTimeout> | undefined;

    function render(done: boolean) {
      root!.dataset.done = String(done);
      // The button's accessible name is the constant aria-label in markup
      // (never touched here) — only aria-pressed conveys state, so a screen
      // reader announces one clear "pressed"/"not pressed" toggle instead
      // of aria-pressed AND a changing visible label both trying to say the
      // same thing. `label` (aria-hidden) still gets the sighted-only text.
      button!.setAttribute('aria-pressed', String(done));
      label!.textContent = done ? 'Đã hoàn thành' : 'Đánh dấu hoàn thành';
    }

    function showToast(message: string) {
      toastText!.textContent = message;
      toast!.hidden = false;
      // `announce` (a permanently-rendered, never-hidden aria-live region —
      // see the .sr-only element in markup) is what a screen reader
      // actually picks up: toggling [hidden] and setting text on the same
      // element in one tick is unreliable for triggering the announcement,
      // confirmed via real-browser testing, not just spec reasoning.
      announce!.textContent = message;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast!.hidden = true;
      }, TOAST_DURATION_MS);
    }

    button.addEventListener('click', () => {
      const willBeDone = !(store.get().lessons[lessonId]?.done ?? false);
      store.markDone(lessonId, willBeDone);
      showToast(willBeDone ? 'Đã đánh dấu hoàn thành bài học.' : 'Đã bỏ đánh dấu hoàn thành.');
    });

    undoButton.addEventListener('click', () => {
      const current = store.get().lessons[lessonId]?.done ?? false;
      store.markDone(lessonId, !current);
      clearTimeout(toastTimer);
      toast!.hidden = true;
    });

    unsubscribe = store.subscribe((state) => render(state.lessons[lessonId]?.done ?? false));
  }

  document.addEventListener('astro:page-load', init);
</script>
