---
// "Hoàn thành bài học" toggle. Two placements, one state source (the progress
// store); every `[data-mcb]` on the page is bound and re-rendered from it, so
// copies never drift:
// - "inline" (default): the concept's done-zone card at the end of the lesson
//   (progress badge + hint text + primary button).
// - "aside": compact secondary button in the desktop reader aside.
// All state variants are server-rendered and switched through [data-done]
// (CSS) + aria-pressed, so the client script only mutates attributes/text and
// Astro's scoped styles keep applying. Completing plays the concept motion
// (ring -> disc -> tick + sparks, src/lib/complete-check-motion.ts) and a toast.
interface Props {
  lessonId: string;
  /** "aside" renders the compact desktop-aside button. */
  placement?: 'inline' | 'aside';
  /** Shown in the toast sub line: "12/27 · <domainTitle>". */
  domainId?: string;
  domainTitle?: string;
}

const { lessonId, placement = 'inline', domainId, domainTitle } = Astro.props;
const zone = placement === 'inline';
---

<div
  class:list={['mcb', zone ? 'mcb--zone' : 'mcb--aside']}
  data-mcb
  data-lesson-id={lessonId}
  data-domain-id={domainId}
  data-domain-title={domainTitle}
  data-done="false"
>
  {
    zone && (
      <div class="mcb-badge" data-mcb-check aria-hidden="true">
        <svg viewBox="0 0 84 84" focusable="false">
          <circle class="c-track" cx="42" cy="42" r="38" />
          <path class="c-ghost" d="M29 43l9 9 18-19" />
          <circle class="c-fill" cx="42" cy="42" r="38" pathLength="100" />
          <circle class="c-disc" cx="42" cy="42" r="30" />
          <path class="c-tick" d="M29 43l9 9 18-19" pathLength="100" />
        </svg>
      </div>
    )
  }
  {
    zone && (
      <p class="mcb-hint">
        <span class="mcb-hint__todo">Đọc xong rồi? Đánh dấu để cập nhật tiến độ lĩnh vực.</span>
        <span class="mcb-hint__done">Bài học đã hoàn thành. Tiến độ lĩnh vực đã được cập nhật.</span>
      </p>
    )
  }
  <button
    type="button"
    class:list={['btn', 'mcb-button', zone ? 'btn-primary' : 'btn-secondary btn-sm']}
    data-mcb-button
    aria-pressed="false"
  >
    <svg class="mcb-ck" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5.75 12.5l4 4 8.5-9" pathLength="100"></path>
    </svg>
    <span>Đánh dấu đã xong</span>
  </button>
</div>

<style>
  .mcb {
    --check-size: 52px;
  }

  /* ---- Inline done-zone card (concept .done-zone) ---- */
  .mcb--zone {
    margin: 28px 0 0;
    padding: 18px;
    border-radius: var(--radius-card);
    border: 1px solid var(--line-2);
    background: var(--surface);
    box-shadow: var(--glow);
    display: grid;
    grid-template-columns: var(--check-size) minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    row-gap: 14px;
  }

  .mcb-hint {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-2);
  }

  .mcb--zone .mcb-button {
    grid-column: 1 / -1;
    width: 100%;
  }

  .mcb--zone[data-done='false'] .mcb-hint__done,
  .mcb--zone[data-done='true'] .mcb-hint__todo {
    display: none;
  }

  /* Done: concept .done-btn.is-done - quiet surface, volt-ink tick. */
  .mcb--zone[data-done='true'] .mcb-button {
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--line-2);
    box-shadow: none;
  }

  /* ---- Progress badge: ring -> disc -> tick (final state in CSS) ---- */
  .mcb-badge {
    width: var(--check-size);
    height: var(--check-size);
  }

  .mcb-badge svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    display: block;
  }

  .c-track {
    fill: none;
    stroke: var(--surface-3);
    stroke-width: 3;
  }

  .c-ghost {
    fill: none;
    stroke: var(--line-3);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .c-fill {
    fill: none;
    stroke: var(--volt-ink);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
  }

  .c-disc {
    fill: var(--volt);
    stroke: var(--volt-ink);
    stroke-width: 1.5;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .c-tick {
    fill: none;
    stroke: var(--on-volt);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .mcb[data-done='true'] .c-fill,
  .mcb[data-done='true'] .c-tick {
    stroke-dashoffset: 0;
  }

  .mcb[data-done='true'] .c-disc {
    transform: scale(1);
  }

  .mcb[data-done='true'] .c-ghost {
    opacity: 0;
  }

  /* ---- Button check glyph ---- */
  .mcb-ck {
    flex: none;
    width: 22px;
    height: 22px;
  }

  .mcb-ck path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  .mcb--aside .mcb-ck {
    width: 18px;
    height: 18px;
  }

  .mcb[data-done='true'] .mcb-ck {
    color: var(--volt-ink);
  }

  .mcb--aside .mcb-button {
    width: 100%;
    justify-content: flex-start;
  }

  .mcb--aside[data-done='true'] .mcb-button {
    border-color: var(--volt-ink);
  }

  /* Wide screens: hint left, button right (concept desktop done-zone). */
  @media (min-width: 720px) {
    .mcb--zone {
      grid-template-columns: var(--check-size) minmax(0, 1fr) auto;
      margin-top: 36px;
    }

    .mcb--zone .mcb-button {
      grid-column: auto;
      width: auto;
    }
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { fetchLessonsIndex } from '../../lib/lessons-index-client';
  import { playCompleteMotion } from '../../lib/complete-check-motion';
  import { showReaderToast } from '../../lib/reader-toast';

  let unsubscribers: Array<() => void> = [];
  // Set only around a click-initiated change so page load / cross-tab sync
  // render silently while the user's own completion plays the motion.
  let animateNextDone = false;

  async function domainProgressLabel(domainId: string | undefined, domainTitle: string | undefined) {
    if (!domainId) return undefined;
    try {
      const lessons = (await fetchLessonsIndex()).filter((l) => l.domain === domainId);
      const state = getProgressStore().get();
      const done = lessons.filter((l) => state.lessons[l.id]?.done).length;
      return `${done}/${lessons.length}${domainTitle ? ` · ${domainTitle}` : ''}`;
    } catch {
      return domainTitle;
    }
  }

  function bind(root: HTMLElement): (() => void) | null {
    const lessonId = root.dataset.lessonId;
    const button = root.querySelector<HTMLButtonElement>('[data-mcb-button]');
    if (!lessonId || !button) return null;

    const store = getProgressStore();
    const check = root.querySelector<Element>('[data-mcb-check]');
    const buttonTick = root.querySelector<Element>('.mcb-ck path');
    let lastDone: boolean | null = null;

    function render(done: boolean) {
      root.dataset.done = String(done);
      // Constant visible label = accessible name (WCAG 2.5.3 label-in-name);
      // state is carried by aria-pressed, the badge and the fill.
      button!.setAttribute('aria-pressed', String(done));
      if (animateNextDone && done && lastDone === false) {
        playCompleteMotion({ check, button: button!, buttonTick });
      }
      lastDone = done;
    }

    const onClick = () => {
      const willBeDone = !(store.get().lessons[lessonId]?.done ?? false);
      animateNextDone = true;
      store.markDone(lessonId, willBeDone);
      animateNextDone = false;

      if (willBeDone) {
        void domainProgressLabel(root.dataset.domainId, root.dataset.domainTitle).then((sub) => {
          // Navigated away while the index loaded: don't toast (with an undo
          // for this lesson) on the next page.
          if (!root.isConnected) return;
          showReaderToast({
            icon: 'check',
            title: 'Đã hoàn thành bài',
            sub,
            onUndo: () => store.markDone(lessonId, false),
          });
        });
      } else {
        showReaderToast({ icon: 'close', title: 'Đã bỏ đánh dấu hoàn thành' });
      }
    };
    button.addEventListener('click', onClick);

    const unsubscribe = store.subscribe((state) => render(state.lessons[lessonId]?.done ?? false));
    return () => {
      button.removeEventListener('click', onClick);
      unsubscribe();
    };
  }

  function init() {
    unsubscribers.forEach((fn) => fn());
    unsubscribers = [];
    document.querySelectorAll<HTMLElement>('[data-mcb]').forEach((root) => {
      const off = bind(root);
      if (off) unsubscribers.push(off);
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
