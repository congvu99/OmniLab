---
// Renders into `.continue-reading-slot` on `/`. Both states (empty prompt +
// card) are server-rendered so the client script only ever mutates
// text/attributes/hidden — never innerHTML/createElement — matching the
// scoping-safe pattern every island in this codebase follows (see
// mark-complete-button.astro's header comment for why that matters).
---

<div class="crc" data-crc>
  <!-- Loading state (default until the script resolves the lessons index):
       without it the empty prompt below would flash first and then flip to
       the card, i.e. briefly tell a returning learner they have nothing in
       progress. Shaped like .crc-card so the swap doesn't shift layout. -->
  <div class="crc-card crc-skeleton" data-crc-loading>
    <span class="skeleton crc-skeleton__eyebrow"></span>
    <span class="skeleton crc-skeleton__title"></span>
    <span class="skeleton crc-skeleton__track"></span>
    <span class="skeleton crc-skeleton__percent"></span>
    <span class="sr-only">Đang tải bài đang học…</span>
  </div>
  <p class="crc-empty" data-crc-empty hidden>
    Chưa có bài đang học — chọn một lĩnh vực bên dưới để bắt đầu.
  </p>
  <a href="#" class="crc-card tap-scale" data-crc-card hidden>
    <span class="crc-eyebrow" data-crc-eyebrow></span>
    <span class="crc-title" data-crc-title></span>
    <span class="crc-progress-track" aria-hidden="true"><span class="crc-progress-bar" data-crc-progress-bar></span></span>
    <span class="crc-percent" data-crc-percent></span>
  </a>
</div>

<style>
  .crc {
    margin: 0 var(--space-4) var(--space-5);
  }

  .crc-empty {
    padding: var(--space-4);
    background: var(--surface-2);
    border-radius: var(--radius-card);
    color: var(--ink-2);
    font-size: var(--text-footnote);
  }

  /* See mark-complete-button.astro's [hidden] comment. */
  .crc-card[hidden] {
    display: none;
  }

  .crc-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .crc-card:hover {
      box-shadow: var(--shadow-card), 0 0 0 1px var(--line-strong);
    }
  }

  .crc-eyebrow {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--accent);
  }

  .crc-title {
    font-size: var(--text-title3);
    font-weight: 700;
    color: var(--ink);
  }

  .crc-progress-track {
    margin-top: var(--space-2);
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--surface-2);
    overflow: hidden;
  }

  .crc-progress-bar {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: var(--radius-full);
  }

  .crc-percent {
    font-size: var(--text-caption);
    color: var(--ink-2);
  }

  /* See mark-complete-button.astro's [hidden] comment. */
  .crc-skeleton[hidden] {
    display: none;
  }

  /* Line heights mirror the real card's text rows (font-size x line-height). */
  .crc-skeleton__eyebrow {
    width: 40%;
    height: calc(var(--text-caption) * 1.4);
  }

  .crc-skeleton__title {
    width: 75%;
    height: calc(var(--text-title3) * 1.3);
  }

  .crc-skeleton__track {
    margin-top: var(--space-2);
    height: 4px;
    border-radius: var(--radius-full);
  }

  .crc-skeleton__percent {
    width: 25%;
    height: calc(var(--text-caption) * 1.4);
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { fetchLessonsIndex } from '../../lib/lessons-index-client';

  let unsubscribe: (() => void) | null = null;

  function init() {
    unsubscribe?.();
    unsubscribe = null;

    const root = document.querySelector<HTMLElement>('[data-crc]');
    if (!root) return;
    const empty = root.querySelector<HTMLElement>('[data-crc-empty]');
    const card = root.querySelector<HTMLAnchorElement>('[data-crc-card]');
    const eyebrow = root.querySelector<HTMLElement>('[data-crc-eyebrow]');
    const title = root.querySelector<HTMLElement>('[data-crc-title]');
    const progressBar = root.querySelector<HTMLElement>('[data-crc-progress-bar]');
    const percentText = root.querySelector<HTMLElement>('[data-crc-percent]');
    const loading = root.querySelector<HTMLElement>('[data-crc-loading]');
    if (!empty || !card || !eyebrow || !title || !progressBar || !percentText || !loading) return;

    const store = getProgressStore();

    /** Every render() exit goes through here or the card branch — the skeleton never outlives the first render. */
    function settle() {
      loading!.hidden = true;
    }

    function showEmpty() {
      settle();
      empty!.hidden = false;
      card!.hidden = true;
    }

    async function render() {
      let lessons;
      try {
        lessons = await fetchLessonsIndex();
      } catch {
        showEmpty();
        return;
      }

      // Only ever pick a lesson id that still exists in the index — a
      // renamed/removed lesson's last-visited timestamp must not blank out
      // "Học tiếp" when an older, still-valid unfinished lesson exists.
      const knownIds = new Set(lessons.map((l) => l.id));
      const id = store.lastUnfinished(knownIds);
      if (!id) {
        showEmpty();
        return;
      }

      const entry = lessons.find((l) => l.id === id);
      if (!entry) {
        // Unreachable in practice (id came from knownIds, built from this
        // same `lessons` array), kept as a defensive fallback.
        showEmpty();
        return;
      }

      const ratio = store.get().lessons[id]?.scroll ?? 0;
      const percent = Math.round(ratio * 100);

      eyebrow!.textContent = `Học tiếp · ${entry.domainTitle}`;
      title!.textContent = entry.title;
      card!.href = entry.url;
      progressBar!.style.width = `${percent}%`;
      percentText!.textContent = `${percent}% đã đọc`;

      settle();
      empty!.hidden = true;
      card!.hidden = false;
    }

    unsubscribe = store.subscribe(() => {
      void render();
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
