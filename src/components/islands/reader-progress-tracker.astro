---
// Script-only island (no markup) for the reader page: stamps `visitedAt`
// once per mount, resumes the saved scroll ratio, and saves the live scroll
// ratio as the user reads. Reads the `.lesson-article[data-lesson-id]` DOM
// contract the reader page ([slug].astro) renders.
---

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { onPageLoad } from '../../lib/page-lifecycle';

  const store = getProgressStore();

  // Flush any pending throttled scroll write when the tab is about to be
  // backgrounded or closed. `visibilitychange` -> "hidden" is the reliable
  // signal on iOS Safari (which does not always fire `pagehide` for the
  // "swipe app away" case); `pagehide` covers same-tab navigation away from
  // the site entirely. Without this, up to ~1s of the most recent scroll
  // position (the trailing throttle window) would be silently lost.
  document.addEventListener('pagehide', () => store.flushScroll());
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') store.flushScroll();
  });

  onPageLoad(() => {
    const articleOrNull = document.querySelector<HTMLElement>('.lesson-article[data-lesson-id]');
    const rawLessonId = articleOrNull?.dataset.lessonId;
    if (!articleOrNull || !rawLessonId) return;
    // Re-bound to a variable TS knows is non-null for the rest of this
    // closure (including nested function/rAF callbacks below, where
    // narrowing a `let`-like outer binding doesn't otherwise carry through).
    const article: HTMLElement = articleOrNull;
    const lessonId: string = rawLessonId;

    store.visit(lessonId);

    // Resume scroll position once the just-swapped-in layout has settled
    // (images already have explicit width/height attributes so they don't
    // reflow after paint, so one rAF after astro:page-load is enough — no
    // extra delay/poll needed).
    requestAnimationFrame(() => {
      if (!article.isConnected) return;
      const ratio = store.get().lessons[lessonId]?.scroll;
      if (!ratio) return;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      if (scrollable > 0) window.scrollTo(0, scrollable * ratio);
    });

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        // Belt-and-braces guard (the `astro:before-swap` teardown below
        // already removes this listener before the router swaps the DOM
        // and scrolls to top): never persist a position for a lesson whose
        // article has left the document — a detached listener's scroll
        // event could otherwise overwrite a different lesson's saved
        // position with 0.
        if (!article.isConnected) return;
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - doc.clientHeight;
        const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
        store.saveScroll(lessonId, ratio);
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    return () => {
      window.removeEventListener('scroll', onScroll);
      // Persist the trailing throttled write (if any) before this lesson's
      // DOM is torn down by the upcoming swap.
      store.flushScroll(lessonId);
    };
  });
</script>
