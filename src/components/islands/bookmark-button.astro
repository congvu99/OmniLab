---
// Bookmark toggle. Two placements share one state source (the progress
// store); every `[data-bb]` on the page is bound, so copies stay in sync:
// - "icon" (default): reader top bar `top-actions` slot, 44px icon button
//   (concept navbar .acts button: text-2, volt-ink + filled glyph when saved).
// - "labeled": compact secondary button for the reader aside (>=1280px).
// aria-pressed reflects saved state; the accessible name is constant.
import Icon from '../icon/icon.astro';

interface Props {
  lessonId: string;
  variant?: 'icon' | 'labeled';
}

const { lessonId, variant = 'icon' } = Astro.props;
const labeled = variant === 'labeled';
---

<button
  type="button"
  class:list={['bb', 'tap-scale', labeled ? 'btn btn-secondary btn-sm bb--labeled' : 'bb--icon']}
  data-bb
  data-lesson-id={lessonId}
  aria-pressed="false"
  aria-label={labeled ? undefined : 'Lưu bài học'}
>
  <Icon name="bookmark" size={labeled ? 18 : 21} stroke-width={1.75} aria-hidden="true" class="bb-icon bb-icon--off" />
  <Icon name="bookmark" filled size={labeled ? 18 : 21} stroke-width={1.75} aria-hidden="true" class="bb-icon bb-icon--on" />
  {labeled && <span>Lưu bài học</span>}
</button>

<style>
  .bb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bb--icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--text-2);
    transition: color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease),
      transform var(--dur-1) var(--ease);
  }

  @media (hover: hover) {
    .bb--icon:hover {
      color: var(--text);
      background: var(--surface-2);
    }
  }

  .bb--icon[aria-pressed='true'] {
    color: var(--volt-ink);
  }

  .bb--labeled {
    width: 100%;
    justify-content: flex-start;
  }

  .bb--labeled[aria-pressed='true'] {
    border-color: var(--volt-ink);
  }

  .bb--labeled[aria-pressed='true'] .bb-icon {
    color: var(--volt-ink);
  }

  .bb-icon--on {
    display: none;
  }

  .bb[aria-pressed='true'] .bb-icon--off {
    display: none;
  }

  .bb[aria-pressed='true'] .bb-icon--on {
    display: block;
  }
</style>

<script>
  import { getProgressStore } from '../../lib/progress-store';
  import { showReaderToast } from '../../lib/reader-toast';
  import { prefersReducedMotion } from '../../lib/reduced-motion';

  let unsubscribers: Array<() => void> = [];

  const reducedMotion = prefersReducedMotion;

  function init() {
    unsubscribers.forEach((fn) => fn());
    unsubscribers = [];

    const store = getProgressStore();
    document.querySelectorAll<HTMLButtonElement>('[data-bb]').forEach((button) => {
      const lessonId = button.dataset.lessonId;
      if (!lessonId) return;

      const onClick = () => {
        const saved = store.toggleBookmark(lessonId);
        // Concept: glyph pops (.7 -> 1.15 -> 1, snap easing). Animate whichever
        // of the two glyphs is displayed after the state flip.
        const glyph = Array.from(button.querySelectorAll<SVGElement>('.bb-icon')).find((el) => el.getClientRects().length);
        if (glyph && !reducedMotion()) {
          glyph.animate([{ transform: 'scale(.7)' }, { transform: 'scale(1.15)' }, { transform: 'scale(1)' }], {
            duration: 240,
            easing: 'cubic-bezier(.3,1.35,.5,1)',
          });
        }
        showReaderToast({
          icon: saved ? 'bookmark' : 'close',
          title: saved ? 'Đã lưu bài' : 'Đã bỏ lưu',
          sub: saved ? 'Xem trong tab Đã lưu' : undefined,
        });
      };
      button.addEventListener('click', onClick);
      const unsubscribe = store.subscribe((state) => {
        button.setAttribute('aria-pressed', String(state.bookmarks.includes(lessonId)));
      });
      unsubscribers.push(() => {
        button.removeEventListener('click', onClick);
        unsubscribe();
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
